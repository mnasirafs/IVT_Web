# IVT ML configuration (copy to .env; never commit real values).
# Option A: full ODBC connection string (preferred for service accounts / Windows authentication)
# IVT_ML_DB_CONN=Driver={ODBC Driver 17 for SQL Server};Server=AFS-SQL01;Database=IVT;Trusted_Connection=yes;

# Option B: components
IVT_ML_DB_SERVER=AFS-SQL01
IVT_ML_DB_NAME=IVT
IVT_ML_DB_DRIVER=ODBC Driver 17 for SQL Server
IVT_ML_DB_TRUSTED=1
# IVT_ML_DB_USER=        # only when IVT_ML_DB_TRUSTED=0; use a dedicated least-privilege ML login
# IVT_ML_DB_PASSWORD=    # supply from a secret store, not from this file

# Durable artifact location (models, preprocessing, reference distributions). Use a backed-up share in production.
IVT_ML_ARTIFACT_DIR=\\fileserver\ivt-ml\artifacts
IVT_ML_OUTPUT_DIR=output
IVT_ML_LOG_LEVEL=INFO
