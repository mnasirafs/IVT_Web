
@{
    ViewBag.Title = "SearchConsignments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



@model IEnumerable<AFSDataGateway.Models.vConsignments>

@{


    ViewBag.Title = "All Customer Comments";
    if (TempData["Utype"] == null)
    {
        TempData["Utype"] = 0;
    }
    if (Session["Utype"] == null)
    {
        Session["Utype"] = 0;
    }
    if ((int)TempData["Utype"] == 1 || (int)Session["Utype"] == 1)
    {

        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}


}
<br />
<br />
<br />
<br />
<br />
<br />
@section css {
    <style>
        .filter-table .quick {
            margin-left: 0.5em;
            font-size: 0.8em;
            text-decoration: none;
            font-family: "TitilliumWeb";
        }

        .fitler-table .quick:hover {
            text-decoration: underline;
            font-family: "TitilliumWeb";
        }

        td.alt {
            background-color: #ffc;
            background-color: rgba(255, 255, 0, 0.2);
            font-family: "TitilliumWeb";
        }
    </style>
}




@{
    var startdate = (DateTime)ViewBag.startdate;
    var enddate = (DateTime)ViewBag.enddate;
    var Search = "";
}
<br />
<br />
@using (Html.BeginForm("SearchConsignments", "CustomerAtRisk", FormMethod.Get))
{

<div style="font-family: TitilliumWeb">
    Consignment No:@Html.TextBox("search", Search)
    From Date: @Html.TextBox("startdate", string.Format("{0:dd MMM yyy}", startdate), new { @value = startdate, @class = "datefield", type = "date" })
    To Date: @Html.TextBox("enddate", string.Format("{0:dd MMM yyy}", enddate), new { @value = enddate, @class = "datefield", type = "date" })

    <input type="submit" value="Search" />
</div>

}
<br />
<div style="color:blue;font-family: TitilliumWeb-Regular">
    For The Period Between @startdate.ToShortDateString() and @enddate.ToShortDateString().
</div>

<br />
<table class="table table-bordered table-striped " id="consignmentTable">
    <tr>
        <th style="white-space:nowrap">
            @Html.Label("", (string)"CustomerName")
        </th>
        <th style="white-space:nowrap">
            @Html.Label("", (string)"ManifestNo")
        </th>
        <th>
            @Html.Label("", (string)"ConsignmentNo")
        </th>
        <th>
            @Html.Label("", (string)"FreightStatus")
        </th>

        <th style="white-space:nowrap">
            @Html.Label("", (string)"DespatchDate")
        </th>
        <th style="white-space:nowrap">
            @Html.Label("", (string)"PickupPostcode")
        </th>
        <th>
            @Html.Label("", (string)"DeliveryPostcode")
        </th>
        <th style="white-space:nowrap">
            @Html.Label("", (string)"TotWeightKg")
        </th>
        <th>
            @Html.Label("", (string)"TotVolM")
        </th>
        <th>
            @Html.Label("", (string)"ActualDeliveryDate")
        </th>
        <th>
            @Html.Label("", (string)"Action")
        </th>

    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td style="white-space:nowrap">
                @Html.DisplayFor(modelItem => item.FinanceGroup)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ManifestNo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ConsignmentNo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FreightStatus)
            </td>
            <td>

                @Convert.ToDateTime(item.DespatchDate).ToString("dd/MM/yyyy")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PickupPostcode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DeliveryPostcode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TotWeightKg)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TotVolM)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ActualDeliveryDate)
            </td>

            <td style="white-space:nowrap">
                @Html.ActionLink("View", "ViewConsignment", new { Id = item.cId })
                @*|
                    @Html.ActionLink("Delete", "Delete", new { Id = item.Id })*@

            </td>
        </tr>
    }

</table>


@section scripts {
    <script src="@Url.Content("~/Scripts/jquery.filtertable.js")" type="text/javascript"></script>
    <script type="text/javascript">
        $(document).ready(function () {

            $('#consignmentTable').filterTable({ ignoreClass: 'no-filter' });

            $('#ddlFilterColumns').change(function () {
                var index = $(this).val();
                if (index == "")
                    $('#consignmentTable td').removeClass('no-filter');
                else {
                    $('#consignmentTable>tbody>tr>td').addClass('no-filter');
                    $('#consignmentTable>tbody>tr').each(function () {
                        $('td:eq(' + index + ')', this).removeClass('no-filter');
                    });
                }
            });
        });
    </script>
}