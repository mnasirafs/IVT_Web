
@{
    ViewBag.Title = "Customer Statitistics";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



@model IEnumerable<AFSDataGateway.Models.spGetCustomerCounts_Result>

@{


    ViewBag.Title = "All Customer Comments";
    if (TempData["Utype"] == null)
    {
        TempData["Utype"] = 0;
    }
    if (Session["Utype"] == null)
    {
        Session["Utype"] = 0;
    }
    if ((int)TempData["Utype"] == 1 || (int)Session["Utype"] == 1)
    {

        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}


}
<br />
<br />
<br />
<br />
<br />
<br />
@section css {
    <style>
        .filter-table .quick {
            margin-left: 0.5em;
            font-size: 0.8em;
            text-decoration: none;
        }

        .fitler-table .quick:hover {
            text-decoration: underline;
        }

        td.alt {
            background-color: #ffc;
            background-color: rgba(255, 255, 0, 0.2);
        }
    </style>
}




@{
    var startdate = (DateTime)ViewBag.startdate;
    var enddate = (DateTime)ViewBag.enddate;
}
<br />
<br />
@using (Html.BeginForm("CustomerStat", "CustomerAtRisk", FormMethod.Get))
{

<div style="font-family: TitilliumWeb">
    From Date: @Html.TextBox("startdate", string.Format("{0:dd MMM yyy}", startdate), new { @class = "datefield", type = "date" })
    To Date: @Html.TextBox("enddate", string.Format("{0:dd MMM yyy}", enddate), new { @class = "datefield", type = "date" })

    <input type="submit" value="Counts" />
</div>
    
    <br />
    <div style="color:blue;font-family: TitilliumWeb-Regular">
        For The Period Between @startdate.ToShortDateString() and @enddate.ToShortDateString() .
    </div>
}

<table class="table table-bordered table-striped " id="consignmentTable">
    <tr>

        <th style="white-space:nowrap">
            @Html.Label("", (string)"CustomerName")
        </th>
        <th style="white-space:nowrap">
            @Html.Label("", (string)"Count")
        </th>
        <th>
            @Html.Label("", (string)"Action")
        </th>
        <th style="white-space:nowrap ;visibility:hidden">
            @Html.Label("", (string)"Id")
        </th>

    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td style="white-space:nowrap">
                @Html.DisplayFor(modelItem => item.CustomerName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CNT)
            </td>

            <td style="white-space:nowrap">
                @Html.ActionLink("Details", "SearchConsignments", new { search = "", startdate = startdate, enddate = enddate, Customer_id = item.Customer_id })
                @*|
                    @Html.ActionLink("Delete", "Delete", new { Id = item.Id })*@

            </td>
            <td style="white-space:nowrap;visibility:hidden">
                @Html.DisplayFor(modelItem => item.Customer_id)
            </td>
        </tr>
    }

</table>


@section scripts {
    <script src="@Url.Content("~/Scripts/jquery.filtertable.js")" type="text/javascript"></script>
    <script type="text/javascript">
        $(document).ready(function () {

            $('#consignmentTable').filterTable({ ignoreClass: 'no-filter' });

            $('#ddlFilterColumns').change(function () {
                var index = $(this).val();
                if (index == "")
                    $('#consignmentTable td').removeClass('no-filter');
                else {
                    $('#consignmentTable>tbody>tr>td').addClass('no-filter');
                    $('#consignmentTable>tbody>tr').each(function () {
                        $('td:eq(' + index + ')', this).removeClass('no-filter');
                    });
                }
            });
        });
    </script>
}