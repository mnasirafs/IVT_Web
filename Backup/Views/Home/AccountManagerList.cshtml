@section css {
    <style>
        .filter-table .quick {
            margin-left: 0.5em;
            font-size: 0.8em;
            text-decoration: none;
            font-family: "TitilliumWeb";
        }

        .fitler-table .quick:hover {
            text-decoration: underline;
            font-family: "TitilliumWeb";
        }

        td.alt {
            background-color: #ffc;
            background-color: rgba(255, 255, 0, 0.2);
            font-family: "TitilliumWeb";
        }
    </style>
}

<div style="border: solid 1px blue;visibility: @ViewBag.ViewMessage">
    @if (TempData["message"] != null && @ViewBag.messageStatus == 1)
    {
        @Html.Label("", (string)TempData["message"], new { @class = "mysucesslabel" })
    }
</div>

<div style="border: solid 1px blue;visibility: @ViewBag.ViewMessage; font-family: TitilliumWeb">
    @if (TempData["message"] != null && @ViewBag.messageStatus == 2)
    {
        @Html.Label("", (string)TempData["message"], new { @class = "myfaillabel" })
    }
</div>

<div style="font-family: TitilliumWeb">
    @if ((string)TempData["UserName"] != null)
    {
        @Html.Label("", (string)@ViewBag.lblGreetingAdmin + (string)TempData["UserName"] + "...", new { @class = "lastUpdateLabel" })
    }
</div>
<br />

<div style="font-family: TitilliumWeb">
    <p>
        @Html.ActionLink("New Mapping?", "CreateAccountManager")
        &nbsp
        <input type="button" value="Synchronize Portfolios " class="btn btn-default" onclick="location.href='@Url.Action("SynchronizePortfolios", "Home",new {var = "test" }) '" />
    </p>

</div>

<br />

<table id="AMList" class="table table-bordered table-striped ">
    <tr>
        <th>
            @Html.DisplayName("Customer Code")
        </th>
        <th>
            @Html.DisplayName("Account Manager")
        </th>
        <th>
            @Html.DisplayName("Login Name")
        </th>

        <th>  @Html.DisplayName("Action")</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CustomerCode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AccountManager)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LoginName)
            </td>
            <td>
                @Html.ActionLink("Edit", "ManageAccountManager", new { id = item.Id }) |
                @Html.ActionLink("Delete", "DeleteCustomerAccountManager", new { id = item.Id })
            </td>
        </tr>
    }

</table>

@section scripts {
    <script src="@Url.Content("~/Scripts/jquery.filtertable.js")" type="text/javascript"></script>
    <script type="text/javascript">
        $(document).ready(function () {

            $('#AMList').filterTable({ ignoreClass: 'no-filter' });

            $('#ddlFilterColumns').change(function () {
                var index = $(this).val();
                if (index == "")
                    $('#AMList td').removeClass('no-filter');
                else {
                    $('#AMList>tbody>tr>td').addClass('no-filter');
                    $('#AMList>tbody>tr').each(function () {
                        $('td:eq(' + index + ')', this).removeClass('no-filter');
                    });
                }
            });
        });
    </script>
}
