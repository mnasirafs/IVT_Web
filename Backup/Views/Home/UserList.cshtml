@model IEnumerable<AFSDataGateway.Models.vAccountManagerLogin>

@{
    ViewBag.Title = "UserList";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section css {
    <style>
        .filter-table .quick {
            margin-left: 0.5em;
            font-size: 0.8em;
            text-decoration: none;
        }

        .fitler-table .quick:hover {
            text-decoration: underline;
        }

        td.alt {
            background-color: #ffc;
            background-color: rgba(255, 255, 0, 0.2);
        }
    </style>
}

<br />
<br />
<br />
<br />
<br />
<br />
<br />
<div style="border: solid 1px blue;visibility: @ViewBag.ViewMessage ;font-family: TitilliumWeb-Regular">
    @if (TempData["message"] != null && @ViewBag.messageStatus == 1)
    {
        @Html.Label("", (string)TempData["message"], new { @class = "mysucesslabel" })
    }
</div>



<div style="border: solid 1px blue;visibility: @ViewBag.ViewMessage;font-family: TitilliumWeb-Regular">
    @if (TempData["message"] != null && @ViewBag.messageStatus == 2)
    {
        @Html.Label("", (string)TempData["message"], new { @class = "myfaillabel" })
    }
</div>

<br />
<div style="font-family: TitilliumWeb">
    <p>
        @Html.ActionLink("New User", "CreateUser")
    </p>
    <br />
    </div>

    <table id="UserList" class="table table-bordered table table-striped ">
        <tr>
            <th>
                @Html.Label("Account Manager")
            </th>
            <th>
                @Html.Label("Login Name")
            </th>
            <th>
                @Html.Label("Profile")
            </th>
            <th>
                @Html.Label("User Status")
            </th>
            <th>
                @Html.Label("Last Modified")
            </th>
            <th>  @Html.DisplayName("Action")</th>
        </tr>

        @foreach (var item in Model)
        {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.AccountManager)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.LoginName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.UserProfile)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.UserStatus)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ModifiedDate)
        </td>
        <td>
            @Html.ActionLink("Edit", "EditUser", new { id = item.Id }) |
            @Html.ActionLink("Delete", "DeleteUser", new { id = item.Id })
        </td>
    </tr>
        }

    </table>
    @section scripts {
        <script src="@Url.Content("~/Scripts/jquery.filtertable.js")" type="text/javascript"></script>
        <script type="text/javascript">
            $(document).ready(function () {

                $('#UserList').filterTable({ ignoreClass: 'no-filter' });

                $('#ddlFilterColumns').change(function () {
                    var index = $(this).val();
                    if (index == "")
                        $('#UserList td').removeClass('no-filter');
                    else {
                        $('#UserList>tbody>tr>td').addClass('no-filter');
                        $('#UserList>tbody>tr').each(function () {
                            $('td:eq(' + index + ')', this).removeClass('no-filter');
                        });
                    }
                });
            });
        </script>
    }
