@model AFSDataGateway.Models.User

@{
    ViewBag.Title = "Change Password";
    if (TempData["Utype"] == null)
    {
        TempData["Utype"] = 0;
    }
    if (Session["Utype"] == null)
    {
        Session["Utype"] = 0;
    }
    if ((int)TempData["Utype"] == 1 || (int)Session["Utype"] == 1)
    {

        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}

@section Scripts {

    @Scripts.Render("~/bundles/jqueryui")
    @Styles.Render("~/Content/cssjqryUi")
    @Scripts.Render("~/bundles/modernizr")
    @Styles.Render("~/Content/css")


}
<br />
<br />
<br />
<br />
<br />
<br />
<div style="font-family: TitilliumWeb">
    <h2>Change Password</h2>
    </div>
    <hr />
    <br />
    <div>
        @if (TempData["chngpwdmessage"] != null && @ViewBag.messageStatus == 1)
        {
            @Html.Label("", (string)TempData["chngpwdmessage"], new { @class = "mysucesslabel" })
        }
    </div>

    <div>
        @if (TempData["chngpwdmessage"] != null && @ViewBag.messageStatus == 2)
        {
            @Html.Label("", (string)TempData["chngpwdmessage"], new { @class = "myfaillabel" })
        }
    </div>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="row form-horizontal">
            <div class="col-md-12">

                @*<div class="form-group">
                        @Html.LabelFor(model => model.Username, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-3">
                            @Html.TextBoxFor(model => model.Username, new { htmlAttributes = new { @Value = @ViewBag.UserName, @class = "form-control", placeholder = "User name" } })
                            @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger" })
                        </div>

                    </div>*@

                <div class="form-group">
                    @Html.Label("New Password", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.PasswordFor(model => model.Password, new { htmlAttributes = new { @class = "form-control", placeholder = "Password" } })
                        @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger" })
                    </div>

                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.ConfirmPassword, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.PasswordFor(model => model.ConfirmPassword, new { htmlAttributes = new { @class = "form-control", placeholder = "Confirm Password" } })
                        @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger" })
                    </div>

                </div>


                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" value="Change" class="btn btn-default" />
                    </div>
                </div>
                @Html.Label("", (string)@ViewBag.Message, new { @class = "myfaillabel" })
            </div>




        </div>

    }

