  "portal": { "production": "http://<IVT_PORTAL_HOST>:<PORT>/", "test": "http://<IVT_PORTAL_HOST>:<TEST_PORT>/" },
  "legacyReportApi": { "baseUrl": "http://<REPORT_SERVICE_HOST>:<PORT>/", "timeoutSeconds": 300 },
  "testNotifier": {
    "enabled": false,
    "executable": "<PATH_TO_PYTHON>\\python.exe",
    "arguments": "\"\\\\<SSIS_HOST>\\AFS-Collab\\IVT\\Send_Emails\\Send_Notification_Test.py\"",
    "workingDirectory": "\\\\<SSIS_HOST>\\AFS-Collab\\IVT\\Send_Emails",
    "timeoutSeconds": 900
  },
  "comments": {
    "insertProcedure": "dbo.sp_Insert_ConsignmentLogBook",
