    "adminLoadRoot": "\\\\<SSIS_HOST>\\SSIS_files\\IVT_landing\\Admin_File_Load",
    "holdConnotes": "\\\\<SSIS_HOST>\\SSIS_files\\IVT_landing\\Admin_File_Load\\Hold_Connotes",
    "releaseConnotes": "\\\\<SSIS_HOST>\\SSIS_files\\IVT_landing\\Admin_File_Load\\Release_Connotes",
    "bmsCheck": "\\\\<SSIS_HOST>\\SSIS_files\\IVT_landing\\Admin_File_Load\\BMS_Check",
    "outputRoot": "\\\\<SSIS_HOST>\\SSIS_files\\IVT_files",
    "testRunOutput": "\\\\<SSIS_HOST>\\SSIS_files\\IVT_files\\IVT_Test_Run",
    "exports": {
      "Connote_For_Review": "\\\\<SSIS_HOST>\\SSIS_files\\IVT_files\\Exported_Files\\Connote_For_Review",
      "Accepted_Connotes": "\\\\<SSIS_HOST>\\SSIS_files\\IVT_files\\Exported_Files\\Accepted_Connotes",
      "Released_Connotes": "\\\\<SSIS_HOST>\\SSIS_files\\IVT_files\\Exported_Files\\Released_Connotes",
      "AM_Activity": "\\\\<SSIS_HOST>\\SSIS_files\\IVT_files\\Exported_Files\\AM_Activity",
      "IVT_BMS_Check": "\\\\<SSIS_HOST>\\SSIS_files\\IVT_files\\Exported_Files\\IVT_BMS_Check"
