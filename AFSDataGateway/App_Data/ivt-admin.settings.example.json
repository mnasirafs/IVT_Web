    "emailDomain": null
  },
  "access": { "readerLogins": [], "readerGroups": [ "<DOMAIN\\IVT-Report-Readers>" ] },
  "azure": {
    "enabled": false,
    "storageAccountUrl": "https://<STORAGE_ACCOUNT>.blob.core.windows.net",
