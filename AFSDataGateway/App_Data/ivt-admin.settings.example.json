    "testEngine": "IVT_Engine_Test_Run",
    "referenceDataLoad": "IVT_REF_DATA_LOAD",
    "adminFileLoad": "IVT_Hold_Release_Check"
  },
  "conflictingJobs": [ "IVT_Engine", "IVT_Engine_Silent", "IVT_Engine_Test_Run", "IVT_Engine_Execs_Reports", "IVT_REF_DATA_LOAD", "IVT_Hold_Release_Check" ],
  "productionRunPreparesTest": true,
  "productionRunMirrorsToAzure": false,
  "jobStartObserveSeconds": 20,
  "recentSubmissionBlockMinutes": 10,
  "paths": {
