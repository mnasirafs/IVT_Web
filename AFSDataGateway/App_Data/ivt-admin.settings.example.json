{
  "connections": {
    "production": "Data Source=<IVT_SQL_SERVER>;Initial Catalog=<IVT_DATABASE>;Integrated Security=SSPI;Application Name=IVT-Admin",
    "test": "Data Source=<IVT_SQL_SERVER>;Initial Catalog=<IVT_TEST_DATABASE>;Integrated Security=SSPI;Application Name=IVT-Admin",
    "msdb": "Data Source=<SQL_AGENT_SERVER\\INSTANCE>;Initial Catalog=msdb;Integrated Security=SSPI;Application Name=IVT-Admin",
    "audit": "Data Source=<IVT_SQL_SERVER>;Initial Catalog=<IVT_DATABASE>;Integrated Security=SSPI;Application Name=IVT-Admin-Audit",
    "azureIvt": null
  },
  "sqlCommandTimeoutSeconds": 900,
  "businessTimeZone": "AUS Eastern Standard Time",
  "jobs": {
    "productionEngine": "IVT_Engine",
