<?xml version="1.0"?>
<!-- Azure App Service (https://ivt.azurewebsites.net) build. The database stays on-prem: AFS-SQL01:1433 is reached through
     the App Service Hybrid Connection "ivt-hcn", so "data source=AFS-SQL01" in the connection strings must not change.
     Secrets (IVT_ENTRA_CLIENT_SECRET, SQL passwords, AZURE_OPENAI_*) go in App Service > Environment variables;
     App Service app settings and connection strings override the same-named entries below. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <!-- App Service cannot read App_Data\ivt-chat.secrets.config unless it is deployed; use environment variables instead. -->
    <add key="IVT_ENTRA_ENABLED" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
    <add key="IVT_ENTRA_REQUIRED" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
    <add key="IVT_ENTRA_REDIRECT_URI" value="https://ivt.azurewebsites.net/signin-oidc" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  </appSettings>
  <system.web>
    <!-- No Windows authentication or impersonation on App Service; users sign in with Microsoft Entra ID. -->
    <authentication mode="None" xdt:Transform="SetAttributes"/>
    <identity xdt:Transform="Remove"/>
    <compilation xdt:Transform="RemoveAttributes(debug)"/>
    <customErrors mode="RemoteOnly" xdt:Transform="SetAttributes"/>
  </system.web>
  <system.webServer>
    <directoryBrowse enabled="false" xdt:Transform="SetAttributes"/>
  </system.webServer>
</configuration>
