@model AFSDataGateway.Services.ML.MLScoringStatus
@{
    ViewBag.Title = "Weekly ML scoring";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    Func<string, string> decisions = json =>
    {
        if (string.IsNullOrEmpty(json)) return "";
        try
        {
            var o = Newtonsoft.Json.Linq.JObject.Parse(json);
            var d = o["decisions"] as Newtonsoft.Json.Linq.JObject;
            if (d == null) return "";
            var parts = new System.Collections.Generic.List<string>();
            foreach (var p in d.Properties()) { parts.Add(p.Name.Replace("_", " ").ToLowerInvariant() + ": " + p.Value); }
            return string.Join(", ", parts);
        }
        catch { return ""; }
    };
}
@if (Model.Running != null)
{
    <meta http-equiv="refresh" content="20" />
}
<style>
    .mls h2 { margin: 0 0 4px; }
    .mls .sub { color: #4b5563; margin-bottom: 16px; }
    .mls .box { background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 16px; margin-bottom: 16px; }
    .mls .notice { padding: 10px 14px; border-radius: 6px; margin-bottom: 14px; background: #ecfdf5; border: 1px solid #10b981; }
    .mls .notice.err { background: #fef2f2; border-color: #ef4444; }
    .mls .warn { background: #fffbeb; border: 1px solid #f59e0b; padding: 10px 14px; border-radius: 6px; margin-bottom: 14px; }
    .mls table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .mls th, .mls td { border-bottom: 1px solid #e5e7eb; padding: 6px 8px; text-align: left; vertical-align: top; }
    .mls .st-SUCCEEDED, .mls .st-PUBLISHED { color: #047857; font-weight: 600; }
    .mls .st-FAILED { color: #b91c1c; font-weight: 600; }
    .mls .st-STARTED { color: #b45309; font-weight: 600; }
    .mls pre { background: #111827; color: #e5e7eb; padding: 10px; border-radius: 6px; max-height: 320px; overflow: auto; font-size: 12px; white-space: pre-wrap; }
    .mls .row { display: flex; gap: 14px; align-items: end; flex-wrap: wrap; }
    .mls label { display: block; font-size: 12px; color: #4b5563; }
</style>

<div class="mls">
    <p>@Html.ActionLink("< Admin Controls", "Index", "AdminControls")</p>
    <h2>Weekly ML scoring</h2>
    <p class="sub">Scores every consignment of an invoice week with the anomaly-detection model in <strong>shadow mode</strong>: results go to the ML tables and the ML Findings page; nothing is published to IVT workflows.</p>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="notice @(Model.MessageIsError ? "err" : "")" role="status">@Model.Message</div>
    }
    @if (!Model.Configured)
    {
        <div class="warn"><strong>Not configured on this server.</strong>
            <ul>@foreach (var p in Model.ConfigProblems) { <li>@p</li> }</ul>
            See ivt-ml/docs/operations_runbook.md, section "Running scoring from Admin Controls".</div>
    }

    <div class="box">
        @if (Model.Running != null)
        {
            <p><strong>Running:</strong> @Model.Running.RunId (started @Model.Running.StartedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")). This page refreshes every 20 seconds.</p>
        }
        @using (Html.BeginForm("RunMLScoring", "AdminControls", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="row">
                <div>
                    <label for="week">Invoice week</label>
                    <input type="date" id="week" name="week" value="@(Model.CurrentWeek.HasValue ? Model.CurrentWeek.Value.ToString("yyyy-MM-dd") : "")" required />
                </div>
                <div>
                    <label><input type="checkbox" name="allowCandidate" value="true" checked /> Use candidate models (required until a model is approved)</label>
                    <input type="hidden" name="allowCandidate" value="false" />
                </div>
                <div>
                    <button type="submit" class="btn btn-success" @(Model.Running != null || !Model.Configured ? "disabled" : "")>Run scoring</button>
                </div>
            </div>
            <p class="sub" style="margin:8px 0 0">
                Current invoice week in IVT: <strong>@(Model.CurrentWeek.HasValue ? Model.CurrentWeek.Value.ToString("dd MMM yyyy") : "unknown")</strong>.
                Run after the week's sell data has finished loading.
                @if (Model.ReviewRowsCurrentWeek.HasValue) { <span>ML Findings rows for this week: <strong>@Model.ReviewRowsCurrentWeek</strong>.</span> }
            </p>
        }
    </div>

    <div class="box">
        <h3 style="margin-top:0">Recent ML runs</h3>
        @if (!Model.Runs.Any())
        {
            <p>No runs yet.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Run</th><th>Type</th><th>Week</th><th>Status</th><th>Started</th><th>Finished</th><th>Result</th></tr></thead>
                <tbody>
                    @foreach (var r in Model.Runs)
                    {
                        <tr>
                            <td>@r.RunId</td>
                            <td>@r.RunType</td>
                            <td>@(r.ScoringWeek.HasValue ? r.ScoringWeek.Value.ToString("dd MMM yyyy") : "")</td>
                            <td class="st-@r.Status">@r.Status</td>
                            <td>@r.StartedAt.ToLocalTime().ToString("dd MMM HH:mm")</td>
                            <td>@(r.CompletedAt.HasValue ? r.CompletedAt.Value.ToLocalTime().ToString("dd MMM HH:mm") : "")</td>
                            @if (r.Status == "FAILED" && r.ErrorText != null)
                            {
                                <td title="@r.ErrorText">@(r.ErrorText.Length > 300 ? r.ErrorText.Substring(0, 300) + "..." : r.ErrorText)</td>
                            }
                            else
                            {
                                <td>@decisions(r.MetricsJson)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (Model.LatestLogTail != null)
    {
        <div class="box">
            <h3 style="margin-top:0">Latest log: @Model.LatestLogName</h3>
            <pre>@Model.LatestLogTail</pre>
        </div>
    }
</div>
