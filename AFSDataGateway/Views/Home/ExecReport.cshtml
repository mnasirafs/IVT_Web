<div id="AMCountsDiv">
    <a href="@Url.Action("DownloadCSV_AM_Counts", "Home")">Download CSV</a>
    <table id="AMCounts" style="width: 100%; border-collapse: collapse; margin-top: 20px;">
        <thead style="background-color: #f2f2f2;">
            <tr>
                @*<th style=" font-size:16px;border: 1px solid #ddd; padding: 8px;">Current Exceptions Sort</th>*@
                <th style=" font-size:16px;border: 1px solid #ddd; padding: 8px;">Account Manager</th>
                <th id="currentExceptionsHeader" style=" font-size:16px;border: 1px solid #ddd; padding: 8px;">Current Exceptions</th>
                <th style="font-size: 16px;border: 1px solid #ddd; padding: 8px;">LastWeek Exceptions</th>
                <th style="font-size: 16px;border: 1px solid #ddd; padding: 8px;">Last13W AVG_Exceptions</th>
                <th style="font-size: 16px;border: 1px solid #ddd; padding: 8px;">Current Trading</th>
                <th style="font-size: 16px;border: 1px solid #ddd; padding: 8px;">LastWeek Trading</th>
                <th style="font-size: 16px;border: 1px solid #ddd; padding: 8px;">Last13W AVG_Trading</th>
                <th style="font-size: 16px;border: 1px solid #ddd; padding: 8px;">Exception Rate</th>
                <th style="font-size: 16px;border: 1px solid #ddd; padding: 8px;">Total Ancillary</th>
                <th style="font-size: 16px;border: 1px solid #ddd; padding: 8px;">Ancillary Rate</th>
                <th style="font-size: 16px;border: 1px solid #ddd; padding: 8px;">Held Count</th>
                <th style="font-size: 16px;border: 1px solid #ddd; padding: 8px;">Customer#</th>
                <th style="font-size: 16px;border: 1px solid #ddd; padding: 8px;">Carriers#</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.AM_Count_list)
            {
                <tr>
                    @*<td style="font-size: 16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">@(item.TotalExceptions != null ? String.Format("{0:N0}", item.TotalExceptions) : "N/A")</td>*@
                    <td style="font-size: 16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">@item.AccountManager</td>
                    <td style="font-size: 16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">@(item.TotalExceptions != null ? String.Format("{0:N0}", item.TotalExceptions) : "N/A")</td>
                    <td style="font-size: 16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">@(item.TotalLastWeekCount != null ? String.Format("{0:N0}", item.TotalLastWeekCount) : "N/A")</td>
                    <td style="font-size: 16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">@(item.AverageLast13WeeksAvgCount != null ? String.Format("{0:N0}", item.AverageLast13WeeksAvgCount) : "N/A")</td>
                    <td style="font-size: 16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">@(item.TotalCurrentWeekTradingCount != null ? String.Format("{0:N0}", item.TotalCurrentWeekTradingCount) : "N/A")</td>
                    <td style="font-size: 16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">@(item.TotalLastWeekTradingCount != null ? String.Format("{0:N0}", item.TotalLastWeekTradingCount) : "N/A")</td>
                    <td style="font-size: 16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">@(item.AverageLast13WeeksTradingCountAVG != null ? String.Format("{0:N0}", item.AverageLast13WeeksTradingCountAVG) : "N/A")</td>
                    <td style="font-size: 16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">@(item.ExceptionRate != null ?  item.ExceptionRate.ToString("N2") + "%" : "N/A")</td>
                    <td style="font-size: 16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">@(item.TotalAncillaries != null ? String.Format("{0:N0}", item.TotalAncillaries) : "N/A")</td>
                    <td style="font-size: 16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">@(item.AncillariesRate != null ?  item.AncillariesRate.ToString("N2") + "%" : "N/A")</td>
                    <td style="font-size: 16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">@(item.HeldCount != null ? String.Format("{0:N0}", item.HeldCount) : "N/A")</td>
