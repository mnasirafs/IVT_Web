@{
    var despatchDate = DateTime.Now;

    var Search = "";
}


<div class="form-horizontal">
    <div style="font-family: TitilliumWeb;color:blue">
        <h4>Explore IVT Held Connotes: Use the <strong>Search</strong> function with Connote, Customer, or Error to delve into specific details.</h4>
        <h5>Displayed here are the first 100 records. For the entire dataset, utilize the download CSV button.</h5>
    </div>
</div>
<br />
@using (Html.BeginForm("HeldConsignment", "Home", FormMethod.Get))
{

    <div style="font-family: TitilliumWeb">
        Search(Any) @Html.TextBox("search", Search)

        Account Manager @Html.DropDownList("accountManagerFilter", ViewBag.UniqueAccountManager as SelectList, "Select AccountManager")

        @*Customer Group @Html.DropDownList("customerGroupFilter", ViewBag.UniqueCustomerGroup as SelectList, "Select CustomerGroup")*@


        Customer Group <select id="customerGroupFilter" name="customerGroupFilter" data-url="@Url.Action("GetCustomerGroups", "Home", new { viewname = "CurrentConsignment" })">
            <option value="">@ViewBag.selectedCustomerGroup</option>
        </select>

        @*Customer @Html.DropDownList("customerFilter", ViewBag.UniqueCustomers as SelectList, "Select Customer")*@

        Customer <select id="customerFilter" name="customerFilter" data-url="@Url.Action("GetCustomers", "Home", new { viewname = "CurrentConsignment" })">
            <option value="">@ViewBag.selectedCustomer</option>
        </select>

        Carrier <select id="carrierFilter" name="carrierFilter" data-url="@Url.Action("GetCarriers", "Home", new { viewname = "CurrentConsignment" })">
            <option value="">@ViewBag.selectedCarrier</option>
        </select>


        <input type="submit" value="Search" />
    </div>
    @Html.Hidden("selectedAccountManager", (string)ViewBag.selectedAccountManager, new { id = "selectedAccountManager" })
    @Html.Hidden("selectedCustomerGroup", (string)ViewBag.selectedCustomerGroup, new { id = "selectedCustomerGroup" })
    @Html.Hidden("selectedCustomer", (string)ViewBag.selectedCustomer, new { id = "selectedCustomer" })
    @Html.Hidden("selectedCarrier", (string)ViewBag.selectedCarrier, new { id = "selectedCarrier" })


    <br />
}

<div>
    <a href="@Url.Action("DownloadCSV_HeldConsignment", "Home")" class="btn btn-primary">Download CSV</a>
    <button class="btn btn-secondary" onclick="refreshPage()">Refresh</button>

</div>
<br />

@using (Html.BeginForm("HeldConsignment", "Home", FormMethod.Post, new { @class = "form-to-release" }))
{

    <div class="form-horizontal" style="visibility: @ViewBag.DisplayForSuperAdmin">
        <div style="font-family: TitilliumWeb;color:maroon">
            <h4>You can <strong>Release</strong> multiple connotes shared the same <strong>Justification.</strong> </h4>
        </div>
        <br />

        @Html.Label("Justification", new { title = "Reason" })
        @Html.TextArea("Reason", htmlAttributes: new { placeholder = "Why are you releasing the consignment(s)?", style = "width: 100%; max-width: 100%;", title = "Reasons" })

        <input type="submit" value="Release" class="btn btn-primary" />
    </div>
    <br />
    @*<div style="color:blue;font-family: TitilliumWeb-Regular">
            For The Period Between @startdate.ToShortDateString() and @enddate.ToShortDateString().
        </div>*@
    <hr style="height:2px; width:100%; border-width:0; color:blue; background-color:black" />
    @*<input type="button" name="CheckAll" id="CheckAll" onclick="Selectall();" value="Select All" class="btn btn-primary" />*@


    <div>
        <input type="checkbox" id="CheckAll" /><span style="font-size:16px">Select All</span>
    </div>

    <div id="checkboxes">
        <table id="HeldConsignment" style="width: 100%; border-collapse: collapse; margin-top: 20px;">
            <thead style="background-color: #f2f2f2;">
                <tr>
                    <th>

                    </th>
                    <th>CurrentWeek</th>
                    <th>
                        @Html.Label("", (string)"AM")
                    </th>
                    <th>
                        @Html.Label("", (string)"Connote")
                    </th>
                    <th>
                        @Html.Label("", (string)"Customer")
                    </th>

                    <th class="exception-detail">
                        @Html.Label("", (string)"Held Reason")
                    </th>
                    <th>
                        @Html.Label("", (string)"ErrCode")
                    </th>
                    <th class="exception-detail">
                        @Html.Label("", (string)"Exception")
                    </th>
                    <th>
                        @Html.Label("", (string)"Carrier")
                    </th>

                    <th>
                        @Html.Label("", (string)"ConnoteDate")
                    </th>

                    <th class="exception-detail">
                        @Html.Label("", (string)"Exception Detail")
                    </th>


                    <th>View</th>
                    <th style="visibility: @ViewBag.DisplayForSuperAdmin">Release</th>

                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><input type="checkbox" name="ID" value="@item.Id" class="custom-checkbox chkCheckBoxId" /></td>
                        <td style="font-size: 16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">@Convert.ToDateTime(item.CurrentWeek).ToString("yyyy-MM-dd")</td>
                        <td style="font-size: 16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">
                            @Html.DisplayFor(modelItem => item.AccountManager)
                        </td>
                        <td style="font-size: 16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">
                            @Html.DisplayFor(modelItem => item.Connote)
                        </td>

                        <td style="font-size: 16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">
                            @Html.DisplayFor(modelItem => item.Customer)
                        </td>
                        <td class="exception-detail" title="@item.Comment">
                            @Html.DisplayFor(modelItem => item.Comment)
                        </td>
                        <td style="font-size: 16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">
                            @Html.DisplayFor(modelItem => item.ErrCode)
                        </td>
                        <td class="exception-detail" title="@item.Reason">
                            @Html.DisplayFor(modelItem => item.Reason)
                        </td>
                        <td style="font-size: 16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">
                            @Html.DisplayFor(modelItem => item.Carrier)
                        </td>
                        <td>
                            @{
                                DateTime consignmentDate;
                                string formattedConsignmentDate = DateTime.TryParse(item.cons_date?.ToString(), out consignmentDate)
                                    ? consignmentDate.ToString("dd/MM/yyyy")
                                    : "N/A"; // Show "N/A" if the date is invalid
                            }
                            @formattedConsignmentDate
                        </td>

                        <td class="exception-detail" title="@item.Sub_Reason">
                            @Html.DisplayFor(modelItem => item.Sub_Reason)
                        </td>


                        <td style="white-space:nowrap">
                            @Html.ActionLink("View", "ViewHeldConsignment", new { Id = item.Id })
                        </td>
                        <td style="white-space:nowrap;visibility: @ViewBag.DisplayForSuperAdmin">
                            @Html.ActionLink("Release", "ReleaseConsignment", new { Id = item.Id, Connote = item.Connote, despatchDate = item.cons_date })
                        </td>


                    </tr>
                }
            </tbody>

        </table>
    </div>
}

@section scripts {
    <script src="@Url.Content("~/Scripts/jquery.filtertable.js")" type="text/javascript"></script>
    <script type="text/javascript">
        $(document).ready(function () {

            $('#consignmentTable').filterTable({ ignoreClass: 'no-filter' });

            $('#ddlFilterColumns').change(function () {
                var index = $(this).val();
                if (index == "")
                    $('#consignmentTable td').removeClass('no-filter');
                else {
                    $('#consignmentTable>tbody>tr>td').addClass('no-filter');
                    $('#consignmentTable>tbody>tr').each(function () {
                        $('td:eq(' + index + ')', this).removeClass('no-filter');
                    });
                }
            });
        });
    </script>




