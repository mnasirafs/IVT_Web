
@{
    ViewBag.Title = "Hold Connote";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}



@model IEnumerable<AFSDataGateway.Models.vConsignmentForReview>




@section css {
    <style>
        .filter-table .quick {
            margin-left: 0.5em;
            font-size: 0.8em;
            text-decoration: none;
            font-family: "TitilliumWeb";
        }

