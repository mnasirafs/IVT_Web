
@{
    ViewBag.Title = "Ancillary Summary";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



@model IEnumerable<AFSDataGateway.Models.vAllCurrentDetails>

@{


    ViewBag.Title = "Ancillary Details";
    if (TempData["Utype"] == null)
    {
        TempData["Utype"] = 0;
    }
    if (Session["Utype"] == null)
    {
        Session["Utype"] = 0;
    }
    if ((int)TempData["Utype"] == 1 || (int)Session["Utype"] == 1)
    {

        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
}



@section css {
    <style>
        .filter-table .quick {
            margin-left: 0.5em;
            font-size: 0.8em;
            text-decoration: none;
            font-family: "TitilliumWeb";
        }

        .fitler-table .quick:hover {
            text-decoration: underline;
            font-family: "TitilliumWeb";
        }

        td.alt {
            background-color: #ffc;
            background-color: rgba(255, 255, 0, 0.2);
            font-family: "TitilliumWeb";
        }

        .table {
            font-size: 14px;
        }

        #AncillaryDetail_wrapper {
            overflow-x: auto;
            max-width: 100%; /* Adjust as needed */
        }
    </style>
}

<div style="border: solid 1px blue;font-size:14px; visibility: @ViewBag.ViewMessage;font-family: TitilliumWeb">
    @if (TempData["message"] != null && @ViewBag.messageStatus == 1)
    {
        @Html.Label("", (string)TempData["message"], new { @class = "mysucesslabel" })
    }
</div>

<div style="border: solid 1px blue; font-size:14px; visibility: @ViewBag.ViewMessage;font-family: TitilliumWeb">
    @if (TempData["message"] != null && @ViewBag.messageStatus == 2)
    {
        @Html.Label("", (string)TempData["message"], new { @class = "myfaillabel" })
    }
</div>


<br />
<div class="form-horizontal">
    <div style="font-family: TitilliumWeb;color:blue">
        <h4> List of WorkCode Connote Details.</h4>
        <p>Showing up to 50 matching rows, newest consignment date first. Download CSV includes all matching rows.</p>
    </div>
</div>
<br />


<br />
@using (Html.BeginForm("ViewAncillarySummaryDetails", "Home", FormMethod.Post))
{

    <div class="form-horizontal" style="visibility: @ViewBag.DisplayForSuperAdmin">
        @Html.Label("Hold Reason", new { title = "Reason" })
        @Html.TextArea("Reason", htmlAttributes: new { placeholder = "Why are you holding the consignment(s)?", style = "width: 100%; max-width: 100%;", title = "Reasons" })

        <input type="submit" value="Hold" class="btn btn-primary" />
    </div>
    <br />
    <hr style="height:2px; width:100%; border-width:0; color:blue; background-color:black" />


    <div>
        <a href="@Url.Action("DownloadCSV_AncillaryDetailsData", "Home",new { customer = ViewBag.Customer ,carrier=ViewBag.Carrier,workcode=ViewBag.Workcode})" class="btn btn-primary">Download CSV</a>
    </div>


    <br />
    <div style="font-size:16px; font-family: TitilliumWeb">
        @Html.ActionLink("Back to Parent List", "AncillarySummary")
    </div>
    <br />
    <div>
        <input type="checkbox" id="CheckAll" /><span style="font-size:16px">Select All</span>
    </div>
    <div id="checkboxes">


        <table class="table table-bordered table-striped" id="AncillaryDetail">
            <thead>
                <tr>
                    <th></th>
                    <th style="white-space: nowrap;">@Html.Label("", "CurrentWeek")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "CustomerGroup")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "Customer")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "Carrier")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "ConsignmentNote")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "ConnoteDate")</th>
                    <th>SellNett</th>
                    <th>BuyNett</th>
                    <th>GM$$</th>
                    <th>GM%</th>
                    <th>SellFreight</th>
                    <th>SellOther</th>
                    <th>SellFuel</th>
                    <th>BuyFreight</th>
                    <th>BuyOther</th>
                    <th>BuyFuel</th>
                    <th style="white-space: nowrap;">@Html.Label("", "QTY")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "ChgWeight")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "Cubic")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "FSL_Sell%")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "FSL_Buy%")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "FSL_Var%")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "WorkCode")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "Mov_Weight")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "Mov_Vol")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "Mov_RateIncSurch")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "Mov_DespatchDate")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "Mov_FreightStatus")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "Mov_DeliveryDate")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "Mov_LOB")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "Mov_SpecialIns")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "JobNumber")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "SupplierRef")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "From")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "To")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "ExternalComments")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                <tr>
                    @{
                        decimal totalNett = Convert.ToDecimal(item.Sell_Total_Nett);
                        decimal buyNett = Convert.ToDecimal(item.Buy_Total_Nett);
                        decimal BuyFuel = Convert.ToDecimal(item.Buy_Fuel_Surcharge);
                        decimal SellFuel = Convert.ToDecimal(item.Sell_Fuel_Surch);
                        decimal BuyFreight = Convert.ToDecimal(item.Buy_Freight_Charges);
                        decimal SellFreight = Convert.ToDecimal(item.Sell_Freight_Charges);
                        decimal BuyOther = Convert.ToDecimal(item.Buy_Other_Charges);
                        decimal SellOther = Convert.ToDecimal(item.Sell_Other_Charges);
                    }
                    <td><input type="checkbox" name="ID" value="@item.PrimaryKeyField" class="custom-checkbox chkCheckBoxId" /></td>
                    <td>@Convert.ToDateTime(item.CurrentWeek).ToString("dd/MM/yyyy")</td>
                    <td style="white-space: nowrap;">@Html.DisplayFor(modelItem => item.FinanceGroup)</td>
                    <td style="white-space: nowrap;">@Html.DisplayFor(modelItem => item.Customer)</td>
                    <td style="white-space: nowrap;">@Html.DisplayFor(modelItem => item.Carrier)</td>

                    <td style="white-space: nowrap;">@Html.DisplayFor(modelItem => item.ConsignmentNote)</td>

                    <td style="white-space: nowrap;">@Convert.ToDateTime(item.Cons_Date).ToString("dd/MM/yyyy")</td>
                    <td style="white-space:nowrap">@String.Format("{0:C}", totalNett)</td>
                    <td style="white-space:nowrap">@String.Format("{0:C}", buyNett)</td>
                    <td style="white-space:nowrap">@String.Format("{0:C}", totalNett - buyNett)</td>
                    <td style="white-space:nowrap">@String.Format("{0:0.00}", item.Nett_Margin)</td>
                    <td style="white-space:nowrap">@String.Format("{0:C}", SellFreight)</td>
                    <td style="white-space:nowrap">@String.Format("{0:C}", SellOther)</td>
                    <td style="white-space:nowrap">@String.Format("{0:C}", SellFuel)</td>
                    <td style="white-space:nowrap">@String.Format("{0:C}", BuyFreight)</td>
                    <td style="white-space:nowrap">@String.Format("{0:C}", BuyOther)</td>
                    <td style="white-space:nowrap">@String.Format("{0:C}", BuyFuel)</td>
                    <td style="white-space:nowrap">@Html.DisplayFor(modelItem => item.quantity)</td>
                    <td style="white-space:nowrap">@Html.DisplayFor(modelItem => item.chg_kg)</td>
                    <td style="white-space:nowrap">@Html.DisplayFor(modelItem => item.cubic)</td>
                    <td>@Html.DisplayFor(modelItem => item.FSL___Sell)</td>
                    <td>@Html.DisplayFor(modelItem => item.C_FSL_Buy)</td>
                    <td>@Html.DisplayFor(modelItem => item.FSL___Var)</td>
                    <td>@Html.DisplayFor(modelItem => item.work_code)</td>
                    <td style="white-space: nowrap;">@Html.DisplayFor(modelItem => item.Moveit_TotWeightKg)</td>
                    <td style="white-space: nowrap;">@Html.DisplayFor(modelItem => item.Moveit_TotVolM)</td>
                    <td style="white-space: nowrap;">@Html.DisplayFor(modelItem => item.Moveit_RateIncSurch)</td>
                    <td style="white-space: nowrap;">@Convert.ToDateTime(item.Moveit_DespatchDate).ToString("dd/MM/yyyy")</td>
                    <td>@Html.DisplayFor(modelItem => item.Moveit_FreightStatus)</td>
                    <td style="white-space: nowrap;">@Convert.ToDateTime(item.Moveit_ActualDeliveryDate).ToString("dd/MM/yyyy")</td>
                    <td style="white-space: nowrap;">@Html.DisplayFor(modelItem => item.Moveit_LineOfBusiness)</td>
                    <td style="white-space: nowrap;">@Html.DisplayFor(modelItem => item.Moveit_SpecialIns)</td>
                    <td style="white-space: nowrap;">@Html.DisplayFor(modelItem => item.JobNumber)</td>
                    <td style="white-space: nowrap;">@Html.DisplayFor(modelItem => item.SupplierRef)</td>

                    <td style="white-space: nowrap;">@Html.DisplayFor(modelItem => item.from)</td>
                    <td style="white-space: nowrap;">@Html.DisplayFor(modelItem => item.to)</td>
                    <td style="white-space: nowrap;">@Html.DisplayFor(modelItem => item.ExternalComments)</td>
                </tr>
                }
            </tbody>
        </table>


    </div>
}

@section scripts {
    <script src="@Url.Content("~/Scripts/jquery.filtertable.js")" type="text/javascript"></script>
    <script type="text/javascript">
        $(document).ready(function () {

            $('#consignmentTable').filterTable({ ignoreClass: 'no-filter' });

            $('#ddlFilterColumns').change(function () {
                var index = $(this).val();
                if (index == "")
                    $('#consignmentTable td').removeClass('no-filter');
                else {
                    $('#consignmentTable>tbody>tr>td').addClass('no-filter');
                    $('#consignmentTable>tbody>tr').each(function () {
                        $('td:eq(' + index + ')', this).removeClass('no-filter');
                    });
                }
            });
        });
    </script>




    <script src="~/Scripts/DataTables/jquery.dataTables.js"></script>



    @Scripts.Render("~/bundles/jqueryval")

    <script type="text/javascript">

        function toggleChecked(status) {
            $("#checkboxes input").filter(':visible').each(function () {
                // Set the checked status of each to match the
                // checked status of the check all checkbox:
                //$(this).filter(':visible').find("input:checkbox").attr('checked', true);
                $(this).prop("checked", status);
            });
        }

        $(document).ready(function () {

            // Grab a reference to the check all box:
            var checkAllBox = $("#CheckAll");

            //Set the default value of the global checkbox to true:
            checkAllBox.prop('checked', false);

            // Attach the call to toggleChecked to the
            // click event of the global checkbox:
            checkAllBox.click(function () {
                var status = checkAllBox.prop('checked');
                toggleChecked(status);
            });
        });


    </script>
}
