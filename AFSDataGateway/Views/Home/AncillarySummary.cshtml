                    <th style="white-space:nowrap">
                        @Html.Label("", (string)"AM")
                    </th>
                    <th style="white-space:nowrap">
                        @Html.Label("", (string)"Customer")
                    </th>
                    <th>
                        @Html.Label("", (string)"Carrier")
                    </th>
                    <th>
                        @Html.Label("", (string)"WC")
                    </th>
                    <th>
                        @Html.Label("", (string)"Desc")
                    </th>
                    <th>
                        @Html.Label("", (string)"CurrentWeek#")
                    </th>
                    <th>
                        @Html.Label("", (string)"CurrentWeekAvgSellNett")
                    </th>
                    <th>
                        @Html.Label("", (string)"CurrentWeekAvgBuyNett")
                    </th>

                    <th style="white-space:nowrap">
                        @Html.Label("", (string)"CurrentAVG_GM")
                    </th>
                    <th style="white-space:nowrap">
