
@{
    ViewBag.Title = "Ancillary Summary";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}



@model IEnumerable<AFSDataGateway.Models.vAllCurrentAncillarySummary>





@section css {
    <style>
        .filter-table .quick {
            margin-left: 0.5em;
            font-size: 0.8em;
            text-decoration: none;
            font-family: "TitilliumWeb";
        }

        .fitler-table .quick:hover {
            text-decoration: underline;
            font-family: "TitilliumWeb";
        }

        td.alt {
            background-color: #ffc;
            background-color: rgba(255, 255, 0, 0.2);
            font-family: "TitilliumWeb";
        }

        .table {
            font-size: 14px;
        }

        #AncilarrySummary_wrapper {
            overflow-x: auto;
            max-width: 100%; /* Adjust as needed */
        }
    </style>
}



@{
    var despatchDate = DateTime.Now;

    var Search = "";
}


<div class="form-horizontal">
    <div style="font-family: TitilliumWeb;color:blue">
        <h4>Explore MOST RECENT Ancillary Summary: Use the <strong>Search</strong> function with WorkCode, Customer, or Carrier to delve into specific details.</h4>
        <h5>Displayed here are the first 100 records. For the entire dataset, utilize the download CSV button.</h5>
    </div>
</div>
<br />
@using (Html.BeginForm("AncillarySummary", "Home"))
{

    <div style="font-family: TitilliumWeb">
        Search(Any) @Html.TextBox("search", Search)

        Account Manager @Html.DropDownList("accountManagerFilter", ViewBag.UniqueAccountManager as SelectList, "Select AccountManager")

        Customer Group <select id="customerGroupFilter" name="customerGroupFilter" data-url="@Url.Action("GetCustomerGroups", "Home", new { viewname = "AncillarySummary"})">
            <option value="">@ViewBag.selectedCustomerGroup</option>
        </select>
        Customer <select id="customerFilter" name="customerFilter" data-url="@Url.Action("GetCustomers", "Home", new { viewname = "AncillarySummary"})">
            <option value="">@ViewBag.selectedcustomer</option>
        </select>

        Carrier <select id="carrierFilter" name="carrierFilter" data-url="@Url.Action("GetCarriers", "Home", new { viewname = "AncillarySummary"})">
            <option value="">@ViewBag.selectedCarrier</option>
        </select>

        Workcode <select id="workcodeFilter" name="workcodeFilter" data-url="@Url.Action("GetWorkcodes", "Home", new { viewname = "AncillarySummary"})">
            <option value="">@ViewBag.selectedWorkCode</option>
        </select>
        <input type="submit" value="Search" />
    </div>

    @Html.Hidden("selectedAccountManager", (string)ViewBag.selectedAccountManager, new { id = "selectedAccountManager" })
    @Html.Hidden("selectedCustomerGroup", (string)ViewBag.selectedCustomerGroup, new { id = "selectedCustomerGroup" })
    @Html.Hidden("selectedCustomer", (string)ViewBag.selectedCustomer, new { id = "selectedCustomer" })
    @Html.Hidden("selectedCarrier", (string)ViewBag.selectedCarrier, new { id = "selectedCarrier" })
    @Html.Hidden("selectedWorkCode", (string)ViewBag.selectedWorkCode, new { id = "selectedWorkCode" })
    <br />
    @*<div style="color:blue;font-family: TitilliumWeb-Regular">
            For The Period Between @startdate.ToShortDateString() and @enddate.ToShortDateString().
        </div>*@
    <hr style="height:2px; width:100%; border-width:0; color:blue; background-color:black" />


    <div>
        <a href="@Url.Action("DownloadCSV_AncillarySummary", "Home")" class="btn btn-primary">Download CSV</a>
    </div>
    <br />
    @*<div>
            <input type="checkbox" id="CheckAll" /><span style="font-size:16px">Select All</span>
        </div>*@
    <div id="checkboxes">
        <table id="AncilarrySummary" style="width: 100%; border-collapse: collapse; margin-top: 20px;">
            <thead style="background-color: #f2f2f2;">
