                    <td style="font-size: 16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">
                        @Html.DisplayFor(modelItem => item.C13WeekAvgSellTotalNett)

                    </td>
                    <td style="font-size: 16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">
                        @Html.DisplayFor(modelItem => item.C13WeekAvgBuyTotalNett)

                    </td>
                    <td style="font-size: 16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">
                        @Html.DisplayFor(modelItem => item.AvgGrossMargin)

                    </td>
                    <td style="font-size: 16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">
                        @Html.ActionLink("Drill Down", "ViewAncillarySummaryDetails", new { customer = item.CustomerCode, carrier = item.Carrier, workcode = item.WorkCode })


                        @*@Html.ActionLink("Update", "Edit", new { Id = item.cId, Connote = item.ConsignmentNo, despatchDate = item.DespatchDate })*@

                    </td>

                </tr>
                }
            </tbody>
        </table>
    </div>
}

@section scripts {
    <script src="@Url.Content("~/Scripts/jquery.filtertable.js")" type="text/javascript"></script>
    <script type="text/javascript">
        $(document).ready(function () {

            $('#consignmentTable').filterTable({ ignoreClass: 'no-filter' });

            $('#ddlFilterColumns').change(function () {
                var index = $(this).val();
                if (index == "")
                    $('#consignmentTable td').removeClass('no-filter');
                else {
                    $('#consignmentTable>tbody>tr>td').addClass('no-filter');
                    $('#consignmentTable>tbody>tr').each(function () {
                        $('td:eq(' + index + ')', this).removeClass('no-filter');
                    });
                }
            });
        });
    </script>




