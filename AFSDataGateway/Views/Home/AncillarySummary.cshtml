                        @Html.DisplayFor(modelItem => item.CurrentWeekAvgSellTotalNett)
                    </td>
                    <td style="font-size: 16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">
                        @Html.DisplayFor(modelItem => item.CurrentWeekAvgBuyTotalNett)
                    </td>
