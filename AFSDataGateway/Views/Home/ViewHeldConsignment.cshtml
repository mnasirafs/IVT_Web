@section scripts {
    <script>
        $(document).ready(function () {
            $("#logForm").submit(function (event) {
                event.preventDefault();
                var formData = $(this).serialize();

                $.post("@Url.Action("AddLogComment", "Home")", formData, function (data) {
                    if (data.success) {
                        $("#logTableBody").prepend(`
                            <tr>
                                <td>${data.logType}</td>
                                <td>${data.logText}</td>
                                <td>${data.createdBy}</td>
                                <td>${data.actionTime}</td>
                            </tr>
                        `);
                        $("#LogText").val(""); // Clear the input
                    } else {
                        alert("Failed to add comment.");
                    }
                });
            });
        });
    </script>
}
