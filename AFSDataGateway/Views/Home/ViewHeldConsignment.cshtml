@model AFSDataGateway.Models.vConsignmentForReview

@{
    ViewBag.Title = "View Connote";
    if (TempData["Utype"] == null)
    {
        TempData["Utype"] = 0;
    }
    if (Session["Utype"] == null)
    {
        Session["Utype"] = 0;
    }
    if ((int)TempData["Utype"] == 1 || (int)Session["Utype"] == 1 || (int)TempData["Utype"] == 2 || (int)Session["Utype"] == 2)
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }


}
@section css {
    <style>
        .dl-horizontal dt,
        .dl-horizontal dd {
            font-size: 16px; /* You can adjust the font size to your preference */
            /* Additional styling, if needed */
        }
    </style>

    <style>
        .dl-horizontal dt,
        .dl-horizontal dd {
            font-size: 16px;
        }

        .log-container {
            margin-top: 20px;
        }

        .log-table {
            width: 100%;
            border-collapse: collapse;
        }

            .log-table th, .log-table td {
                border: 1px solid #ddd;
                padding: 8px;
            }

            .log-table th {
                background-color: #f2f2f2;
                text-align: left;
            }
    </style>
}
<div style="font-family: TitilliumWeb">
    <h2>View Consignment</h2>
</div>
<div>

    <hr />
    <br />
    <br />
    <!-- Display Log History -->
    <div class="log-container">
        <h4>Consignment Activity Log</h4>
        <table class="log-table">
            <thead>
                <tr>
                    <th>Log Type</th>
                    <th>Comment</th>
                    <th>Created By</th>
                    <th>Action Time</th>
                </tr>
            </thead>
            <tbody id="logTableBody">
                @if (ViewBag.ConsignmentLogs != null)
                {
                    foreach (var log in ViewBag.ConsignmentLogs)
                    {
                        <tr>
                            <td>@log.LogType</td>
                            <td>@log.LogText</td>
                            <td>@log.CreatedBy</td>
                            <td>@log.ActionTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Add New Comment -->
    <div class="log-container">
        <h4>Add a Comment</h4>
        @using (Html.BeginForm("AddLogComment", "Home", FormMethod.Post, new { id = "logForm" }))
        {
            @Html.Hidden("JobNumber", Model.jno)
            @Html.Hidden("LogType", "Hold") <!-- This ensures "Hold" is sent when submitting -->

            <div>
                <label for="LogText">Comment:</label>
                <textarea name="LogText" id="LogText" class="form-control" placeholder="Enter your comment..." required></textarea>
            </div>
            <br />
            <button type="submit" class="btn btn-primary">Submit Comment</button>
        }
    </div>


    <br />

    <div style="font-family: TitilliumWeb">
        <h4>Details for the Connote: @Model.Connote</h4>
    </div>
    <hr />
    <div style="font-size:16px; font-family: TitilliumWeb">

        <a href="javascript:void(0);" onclick="history.go(-1);">Back to List</a>
    </div>


