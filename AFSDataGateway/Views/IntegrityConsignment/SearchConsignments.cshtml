
@{
    ViewBag.Title = "SearchConsignments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



@model IEnumerable<AFSDataGateway.Models.vIntegrityConnoteReadyToHide>

@{


    ViewBag.Title = "Search Consignments";
    if (TempData["Utype"] == null)
    {
        TempData["Utype"] = 0;
    }
    if (Session["Utype"] == null)
    {
        Session["Utype"] = 0;
    }
    if ((int)TempData["Utype"] == 1 || (int)Session["Utype"] == 1)
    {

        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}



@section css {
    <style>
        .filter-table .quick {
            margin-left: 0.5em;
            font-size: 0.8em;
            text-decoration: none;
            font-family: "TitilliumWeb";
        }

        .fitler-table .quick:hover {
            text-decoration: underline;
            font-family: "TitilliumWeb";
        }

        td.alt {
            background-color: #ffc;
            background-color: rgba(255, 255, 0, 0.2);
            font-family: "TitilliumWeb";
        }

        .table {
            font-size: 14px;
        }
    </style>
}

<div style="font-family: TitilliumWeb">
    @if ((string)TempData["UserName"] != null)
    {
        @Html.Label("", (string)@ViewBag.lblGreeting + (string)TempData["UserName"] + "...", new { @class = "lastUpdateLabel" })
    }
</div>
<br />
<div style="border: solid 1px blue;font-size:14px; visibility: @ViewBag.ViewMessage;font-family: TitilliumWeb">
    @if (TempData["message"] != null && @ViewBag.messageStatus == 1)
    {
        @Html.Label("", (string)TempData["message"], new { @class = "mysucesslabel" })
    }
</div>

<div style="border: solid 1px blue; font-size:14px; visibility: @ViewBag.ViewMessage;font-family: TitilliumWeb">
    @if (TempData["message"] != null && @ViewBag.messageStatus == 2)
    {
        @Html.Label("", (string)TempData["message"], new { @class = "myfaillabel" })
    }
</div>



@{
    var despatchDate = DateTime.Now;

    var Search = "";
}


<div class="form-horizontal">
    <div style="font-family: TitilliumWeb;color:blue">
        <h4>List of Connotes with Issues, <strong>Search</strong> using Connote and/or Part of Exception to <strong>Hide</strong> or <strong>Update</strong> Connote's details </h4>
    </div>
</div>
<br />

@using (Html.BeginForm("SearchConsignments", "IntegrityConsignment", FormMethod.Get))
{
    <div style="font-family: TitilliumWeb">
        Connote or Exception:@Html.TextBox("search", Search)
        <input type="submit" value="Search" />
    </div>


}

<br />
@using (Html.BeginForm("SearchConsignments", "IntegrityConsignment"))
{


    <div style="font-family: TitilliumWeb;color:maroon">
        <h4>You can <strong>HIDE</strong> multiple connotes shared the same <strong>reason.</strong> </h4>
    </div>
    <br />
    <div class="form-horizontal">
        @Html.Label("Hide Reason", new { title = "Reason" })
        @Html.TextArea("Reason", htmlAttributes: new { placeholder = "Reason", style = "width: 100%; max-width: 100%;", title = "Reasons" })

        <input type="submit" value="Hide" class="btn btn-primary" />
    </div>
    <br />
    @*<div style="color:blue;font-family: TitilliumWeb-Regular">
            For The Period Between @startdate.ToShortDateString() and @enddate.ToShortDateString().
        </div>*@
    <hr style="height:2px; width:100%; border-width:0; color:blue; background-color:black" />
    @*<input type="button" name="CheckAll" id="CheckAll" onclick="Selectall();" value="Select All" class="btn btn-primary" />*@

    <div>
        <a href="@Url.Action("DownloadCSV_SearchConsignments", "IntegrityConsignment")" class="btn btn-primary">Download CSV</a>
    </div>
    <br />
    @*<div>
            <input type="checkbox" id="CheckAll" /><span>Select All</span>
        </div>
        <br />*@

    <div>
        <input type="checkbox" id="CheckAll" /><span style="font-size:16px">Select All</span>
    </div>
    <br />

    <div id="checkboxes">
        <table class="table table-bordered table-striped " id="consignmentTable">
            <tr>
                <th>

                </th>
                <th>
                    @Html.Label("", (string)"CatchFilter")
                </th>
                <th>
                    @Html.Label("", (string)"Pickup Address")
                </th>
                <th>
                    @Html.Label("", (string)"ConsignmentNo")
                </th>

                <th style="white-space:nowrap">
                    @Html.Label("", (string)"DespatchDate")
                </th>

                <th>
                    @Html.Label("", (string)"DeliveryAddress")
                </th>
                <th>
                    @Html.Label("", (string)"Freight Status")
                </th>
                <th style="white-space:nowrap">
                    @Html.Label("", (string)"TotWeightKg")
                </th>
                <th>
                    @Html.Label("", (string)"RateIncSurch")
                </th>
                <th>
                    @Html.Label("", (string)"TotVolM")
                </th>

                <th>
                    @Html.Label("", (string)"Action")
                </th>

            </tr>

            @foreach (var item in Model)
            {
                <tr>
                    <td><input type="checkbox" name="ID" value="@item.cId" class="custom-checkbox chkCheckBoxId" /></td>
                    <td style="white-space:nowrap">
                        @Html.DisplayFor(modelItem => item.CatchFilter)
                    </td>
                    <td style="white-space:nowrap">
                        @Html.DisplayFor(modelItem => item.PickupAddress1)
                    </td>

                    <td style="white-space:nowrap">
                        @Html.DisplayFor(modelItem => item.ConsignmentNo)
                    </td>

                    <td>

                        @Convert.ToDateTime(item.DespatchDate).ToString("dd/MM/yyyy")
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.DeliveryAddress1)
                    </td>
                    <td style="white-space:nowrap">
                        @Html.DisplayFor(modelItem => item.FreightStatus)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.TotWeightKg)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.RateIncSurch)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.TotVolM)
                    </td>


                    <td style="white-space:nowrap">
                        @Html.ActionLink("View", "ViewConsignment", new { Id = item.cId })
                        |
                        @Html.ActionLink("Hide", "HideConsignment", new { Id = item.cId, Connote = item.ConsignmentNo, despatchDate = item.DespatchDate })
                        |
                        @Html.ActionLink("Update", "Edit", new { Id = item.cId, Connote = item.ConsignmentNo, despatchDate = item.DespatchDate })

                    </td>
                </tr>
            }

        </table>
    </div>
}

@section scripts {
    <script src="@Url.Content("~/Scripts/jquery.filtertable.js")" type="text/javascript"></script>
    <script type="text/javascript">
        $(document).ready(function () {

            $('#consignmentTable').filterTable({ ignoreClass: 'no-filter' });

            $('#ddlFilterColumns').change(function () {
                var index = $(this).val();
                if (index == "")
                    $('#consignmentTable td').removeClass('no-filter');
                else {
                    $('#consignmentTable>tbody>tr>td').addClass('no-filter');
                    $('#consignmentTable>tbody>tr').each(function () {
                        $('td:eq(' + index + ')', this).removeClass('no-filter');
                    });
                }
            });
        });
    </script>




