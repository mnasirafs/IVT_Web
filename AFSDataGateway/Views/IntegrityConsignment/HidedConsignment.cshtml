
@{
    ViewBag.Title = "Hided Consignments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



@model IEnumerable<AFSDataGateway.Models.vConnoteToHide>

@{


    ViewBag.Title = "Hided Consignments";
    if (TempData["Utype"] == null)
    {
        TempData["Utype"] = 0;
    }
    if (Session["Utype"] == null)
    {
        Session["Utype"] = 0;
    }
    if ((int)TempData["Utype"] == 1 || (int)Session["Utype"] == 1)
    {

        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}


