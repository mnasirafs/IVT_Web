@using (Html.BeginForm("HidedConsignment", "IntegrityConsignment"))
{

    <br />
    <div style="font-family: TitilliumWeb;color:maroon">
        <h4>You can <strong>UN HIDE</strong> multiple connotes to <strong>appear</strong> again in the report.</h4>
    </div>
    <br />
    <div class="form-horizontal">
        @*  *@
        <input type="submit" value="Un Hide" class="btn btn-primary" />
    </div>
    <br />
    @*<div style="color:blue;font-family: TitilliumWeb-Regular">
            For The Period Between @startdate.ToShortDateString() and @enddate.ToShortDateString().
        </div>*@

    <hr style="height:2px; width:100%; border-width:0; color:blue; background-color:black" />
    <div>
        <a href="@Url.Action("DownloadCSV_HidedConsignment", "IntegrityConsignment")" class="btn btn-primary">Download CSV</a>
    </div>
    <br />
    <div>
        <input type="checkbox" id="CheckAll" /><span>Check All</span>
    </div>
    <br />

    <div id="checkboxes">
        <table class="table table-bordered table-striped " id="consignmentTable">
            <tr>
                <th>

                </th>
                <th>
                    @Html.Label("", (string)"ConsignmentNo")
                </th>

                <th style="white-space:nowrap">
                    @Html.Label("", (string)"DespatchDate")
                </th>

                <th>
                    @Html.Label("", (string)"Reason")
                </th>
                <th style="white-space:nowrap">
                    @Html.Label("", (string)"Hided By")
                </th>
                <th>
                    @Html.Label("", (string)"Hided At")
                </th>

                <th>
                    @Html.Label("", (string)"Action")
                </th>

            </tr>

            @foreach (var item in Model)
            {
                <tr>
                    <td><input type="checkbox" name="ID" value="@item.id" class="custom-checkbox chkCheckBoxId" /></td>
                    <td style="white-space:nowrap">
                        @Html.DisplayFor(modelItem => item.Connote)
                    </td>


                    <td>

                        @Convert.ToDateTime(item.DespatchDate).ToString("dd/MM/yyyy")
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Reason)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.HidedBy)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ActionTime)
                    </td>

                    <td style="white-space:nowrap">

                        @Html.ActionLink("UnHide", "UnHide", new { Id = item.id, Connote = item.Connote, despatchDate = item.DespatchDate })
                        |
                        @Html.ActionLink("Update Reason", "HideUpdate", new { Id = item.id, Connote = item.Connote, despatchDate = item.DespatchDate })

                    </td>
                </tr>
            }

        </table>
    </div>


    @section scripts {
        <script src="@Url.Content("~/Scripts/jquery.filtertable.js")" type="text/javascript"></script>
        <script type="text/javascript">
            $(document).ready(function () {

                $('#consignmentTable').filterTable({ ignoreClass: 'no-filter' });

                $('#ddlFilterColumns').change(function () {
                    var index = $(this).val();
                    if (index == "")
                        $('#consignmentTable td').removeClass('no-filter');
                    else {
                        $('#consignmentTable>tbody>tr>td').addClass('no-filter');
                        $('#consignmentTable>tbody>tr').each(function () {
                            $('td:eq(' + index + ')', this).removeClass('no-filter');
                        });
                    }
                });
            });
        </script>


        @Scripts.Render("~/bundles/jqueryval")

        <script type="text/javascript">

            function toggleChecked(status) {
                $("#checkboxes input").filter(':visible').each(function () {
                    // Set the checked status of each to match the
                    // checked status of the check all checkbox:
                    //$(this).filter(':visible').find("input:checkbox").attr('checked', true);
                    $(this).prop("checked", status);
                });
            }

            $(document).ready(function () {

                // Grab a reference to the check all box:
                var checkAllBox = $("#CheckAll");

                //Set the default value of the global checkbox to true:
                checkAllBox.prop('checked', false);

                // Attach the call to toggleChecked to the
                // click event of the global checkbox:
                checkAllBox.click(function () {
                    var status = checkAllBox.prop('checked');
                    toggleChecked(status);
                });
            });

                                                            //function Selectall() {
                                                            //    if ($('.chkCheckBoxId').is(':checked')) {
                                                            //        // .JchkGrid cssClass will be assigned to all other checkboxes in your control
                                                            //        $('.chkCheckBoxId').attr('checked', 'true');
                                                            //    }
                                                            //    else {
                                                            //        $('.chkCheckBoxId').removeAttr('checked', 'false');
                                                            //    }
                                                            //}

        </script>
    }
}
