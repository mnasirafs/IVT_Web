    @* <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>*@

    <script>

        function toggleChecked(status) {
            $("#checkboxes input").filter(':visible').each(function () {
                // Set the checked status of each to match the
                // checked status of the check all checkbox:
                //$(this).filter(':visible').find("input:checkbox").attr('checked', true);
                $(this).prop("checked", status);
            });
        }

        $(document).ready(function () {

            // Grab a reference to the check all box:
            var checkAllBox = $("#CheckAll");

            //Set the default value of the global checkbox to true:
            checkAllBox.prop('checked', false);

            // Attach the call to toggleChecked to the
            // click event of the global checkbox:
            checkAllBox.click(function () {
                var status = checkAllBox.prop('checked');
                toggleChecked(status);
            });
        });


        $(document).ready(function () {
            // Correct initialization calls
            updateCustomerDropdown();
            updateCarrierDropdown();
            updateWorkcodeDropdown();




            // Consolidating event handlers to avoid potential conflicts or repeated calls
            $("#customerGroupFilter").change(function () {
                updateCustomerDropdown();
                // Depending on your logic, you might want to update carriers and workcodes here too
            });

            $("#customerFilter").change(function () {
                updateCarrierDropdown(); // Update carriers when customers change
                updateWorkcodeDropdown(); // Potentially update workcodes based on new carriers
            });

            $("#carrierFilter").change(updateWorkcodeDropdown); // Simplified call for updating workcodes

            // Function to update the Carrier dropdown based on Customers selected
            function updateCarrierDropdown() {
                var selectedCustomers = $("#customerFilter").val(); // Getting the array of selected customers
                var carrierUrl = $("#carrierFilter").data('url'); // Ensure this URL is correctly set in HTML

                $.ajax({
                    url: carrierUrl,
                    type: 'GET',
                    traditional: true,
                    data: { customers: selectedCustomers },
                   success: function (data) {
                        var carrierSelect = $("#carrierFilter");
                        var previouslySelectedCarriers = "@Html.Raw(ViewBag.SelectedCarrier != null ? string.Join(",", ViewBag.SelectedCarrier) : "")".split(',');

                        carrierSelect.empty().append('<option value="">Select Carrier</option>');
                        $.each(data, function (i, item) {
                            var isSelected = previouslySelectedCarriers.includes(item.value);
                            carrierSelect.append($('<option>', {
                                value: item.value,
                                text: item.text,
                                selected: isSelected
                            }));
                        });
                    }

                });
            }



            function updateCustomerDropdown() {
                var selectedCustomerGroup = $("#customerGroupFilter").val(); // Assuming this is the dependency
                var customerUrl = $("#customerFilter").data("url");

                $.ajax({
                    url: customerUrl,
                    type: 'GET',
                    traditional: true,
                    data: { customergroup: selectedCustomerGroup },
                   success: function (data) {
                        var customerSelect = $("#customerFilter");
                        // Assuming previouslySelectedCustomers is populated similarly to previouslySelectedCarriers
                        var previouslySelectedCustomers = "@Html.Raw(ViewBag.SelectedCustomer != null ? string.Join(",", ViewBag.SelectedCustomer) : "")".split(',');

                        customerSelect.empty().append('<option value="">Select Customer</option>');
                        $.each(data, function (i, item) {
                            var isSelected = previouslySelectedCustomers.includes(item.value);
                            customerSelect.append($('<option>', {
                                value: item.value,
                                text: item.text,
                                selected: isSelected
                            }));
                        });

                        // Trigger any change events as needed
                        customerSelect.change();
                    }
                });
            }


            function updateWorkcodeDropdown() {
                var selectedCustomer = $("#customerFilter").val(); // This is now an array
                var selectedCarrier = $("#carrierFilter").val(); // This is also an array
                var workcodeUrl = $("#workcodeFilter").data("url");
                console.log("Data sent:", { customers: selectedCustomer, carriers: selectedCarrier });

                $.ajax({
                    url: workcodeUrl,
                    type: 'GET',
                    traditional: true, // Ensures jQuery serializes the data in a traditional way, suitable for ASP.NET MVC
                    data: {
                        customer: selectedCustomer,
                        carrier: selectedCarrier
                    },
                  success: function (data) {
                        var workcodeSelect = $("#workcodeFilter");
                        // Assuming previouslySelectedWorkcodes is populated similarly
                        var previouslySelectedWorkcodes = "@Html.Raw(ViewBag.SelectedWorkCode != null ? string.Join(",", ViewBag.SelectedWorkCode) : "")".split(',');

                        workcodeSelect.empty().append('<option value="">Select Workcode</option>');
                        $.each(data, function (i, item) {
                            var isSelected = previouslySelectedWorkcodes.includes(item.value);
                            workcodeSelect.append($('<option>', {
                                value: item.value,
                                text: item.text,
                                selected: isSelected
                            }));
                        });

                        // Trigger any change events as needed
                        workcodeSelect.change();
                    }
                });
            }

        });


        $('form').submit(function () {
            // Before form submission, update hidden fields with selected values
            var selectedCustomers = $('#customerFilter').val() || [];
            var selectedCarriers = $('#carrierFilter').val() || [];
            var selectedWorkcodes = $('#workcodeFilter').val() || [];

            $('#selectedCustomer').val(selectedCustomers.join(',')); // Convert array to comma-separated string
            $('#selectedCarrier').val(selectedCarriers.join(','));
            $('#selectedWorkCode').val(selectedWorkcodes.join(','));
        });



        $(document).ready(function () {
            // Function to update the text for selected options
            function updateSelectedText(selectElementId, displayElementId) {
                var selected = $(selectElementId).find('option:selected');
                var selectedValues = selected.length > 0 ? selected.map(function () { return $(this).text(); }).get().join(', ') : 'None';
                $(displayElementId).text('Selected: ' + selectedValues);
            }

            // Event handlers for each select element
            $('#customerFilter').change(function () {
                updateSelectedText('#customerFilter', '#selectedCustomers');
            });

            $('#carrierFilter').change(function () {
                updateSelectedText('#carrierFilter', '#selectedCarriers');
            });

            $('#workcodeFilter').change(function () {
                updateSelectedText('#workcodeFilter', '#selectedWorkcodes');
            });

            // Initial update in case there's a pre-selected value
            updateSelectedText('#customerFilter', '#selectedCustomers');
            updateSelectedText('#carrierFilter', '#selectedCarriers');
            updateSelectedText('#workcodeFilter', '#selectedWorkcodes');
        });


        function updateDownloadLink() {
    var search = encodeURIComponent($('#search').val());
    var customerGroupFilter = encodeURIComponent($('#customerGroupFilter').val());
    var customerFilter = $('#customerFilter').val() || [];
    var carrierFilter = $('#carrierFilter').val() || [];
    var workcodeFilter = $('#workcodeFilter').val() || [];
    var supplierRef = encodeURIComponent($('#SupplierRef').val());
    var sellNett = encodeURIComponent($('#SellNett').val());

    var href = '@Url.Action("DownloadCSV_TradingData", "IVT")' +
               '?Search=' + search +
               '&customerGroupFilter=' + customerGroupFilter +
               '&customerFilter=' + customerFilter.join(',') +
               '&carrierFilter=' + carrierFilter.join(',') +
               '&workcodeFilter=' + workcodeFilter.join(',') +
               '&SupplierRef=' + supplierRef +
               '&SellNett=' + sellNett;

    $('#downloadCsvLink').attr('href', href);
}


    $('#customerFilter').change(updateDownloadLink);
    $('#carrierFilter').change(updateDownloadLink);
    $('#workcodeFilter').change(updateDownloadLink);
    $('#customerGroupFilter').change(updateDownloadLink);
    // Add change handlers for any other inputs that should update the link
    $('#search').keyup(updateDownloadLink);
    $('#SupplierRef').keyup(updateDownloadLink);
    $('#SellNett').keyup(updateDownloadLink);

    // Call once on page load to initialize
    updateDownloadLink();




    </script>

}
