@using (Html.BeginForm("TradingData", "IVT", FormMethod.Get))
{
    <br />





    <div class="filter-instructions">
        Use CTRL (or CMD on Mac) to select multiple values.
    </div>
    <div class="filter-container">

        <div class="filter-text">
            <div class="input-group">
                <label for="search">Search</label>
                @Html.TextBox("search", ViewBag.Search as string, new { @id = "search", @placeholder = "Enter search term (Connote, Customer, Carrier, Or WorkCode)." })
            </div>
        </div>




        <div>
            <label for="customerGroupFilter">Customer Group</label>
            @Html.DropDownList("customerGroupFilter", ViewBag.UniqueCustomerGroup as SelectList, "Select CustomerGroup", new { @id = "customerGroupFilter" })
        </div>



        <div>
              <label for="customerFilter">Customer</label>
            <select id="customerFilter" name="customerFilter" multiple data-url="@Url.Action("GetCustomers", "IVT", new { viewname = "TradingData"})">
                @foreach (var customer in ViewBag.UniqueCustomers as IEnumerable<SelectListItem>)
                {
                    <option value="@customer.Value" @(ViewBag.SelectedCustomer != null && ((string[])ViewBag.SelectedCustomer).ToList().Contains(customer.Value) ? "selected" : "")>@customer.Text</option>
                }
            </select>

            <div id="selectedCustomers" class="selected-values"></div>
        </div>

        <div>
            <label for="carrierFilter">Carrier</label>
            <select id="carrierFilter" name="carrierFilter" multiple data-url="@Url.Action("GetCarriers", "IVT", new { viewname = "TradingData"})">
                @foreach (var carrier in ViewBag.UniqueCarriers as IEnumerable<SelectListItem>)
                {
                    bool isSelected = ViewBag.SelectedCarrier != null && ((string[])ViewBag.SelectedCarrier).ToList().Contains(carrier.Text);
                    <option value="@carrier.Value" @(Html.Raw(isSelected ? "selected=\"selected\"" : ""))>@carrier.Text</option>
                }
            </select>

            <div id="selectedCarriers" class="selected-values"></div>

        </div>

        <div>
            <label for="workcodeFilter">Workcode</label>
            <select id="workcodeFilter" name="workcodeFilter" multiple data-url="@Url.Action("GetWorkcodes", "IVT", new { viewname = "TradingData"})">
                @foreach (var workcode in ViewBag.UniqueWorkcodes as IEnumerable<SelectListItem>)
                {
                    <option value="@workcode.Value" @(ViewBag.SelectedWorkCode != null && ((string[])ViewBag.SelectedWorkCode).ToList().Contains(workcode.Value) ? "selected" : "")>@workcode.Text</option>
                }
            </select>
            <div id="selectedWorkcodes" class="selected-values"></div>

        </div>

        <div class="filter-text">
           
            <div class="input-group">
                <label for="SupplierRef">Supplier Ref</label>
                @Html.TextBox("SupplierRef", ViewBag.SupplierRef as string, new { @id = "SupplierRef", @placeholder = "Enter Supplier Ref." })
            </div>
            <div class="input-group">
                <label for="SellNett">Sell Nett ( > )</label>
                @Html.TextBox("SellNett", ViewBag.SellNett as string, new { @id = "SellNett", @placeholder = "Enter Sell Nett greater than." })
            </div>
        </div>


        <input type="submit" value="Search" />
    </div>

    @Html.Hidden("selectedCustomerGroup", (string)ViewBag.selectedCustomerGroup, new { id = "selectedCustomerGroup" })
    @Html.Hidden("selectedCustomer", ViewBag.selectedCustomer != null ? string.Join(",", ViewBag.selectedCustomer as string[]) : "", new { id = "selectedCustomer" })
    @Html.Hidden("selectedCarrier", ViewBag.selectedCarrier != null ? string.Join(",", ViewBag.selectedCarrier as string[]) : "", new { id = "selectedCarrier" })
    @Html.Hidden("selectedWorkCode", ViewBag.selectedWorkCode != null ? string.Join(",", ViewBag.selectedWorkCode as string[]) : "", new { id = "selectedWorkCode" })

}
