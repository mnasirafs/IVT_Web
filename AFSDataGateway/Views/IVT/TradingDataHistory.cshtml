        //        $('.chkCheckBoxId').attr('checked', 'true');
        //    }
        //    else {
        //        $('.chkCheckBoxId').removeAttr('checked', 'false');
        //    }
        //}

    </script>

    <script>

        $(document).ready(function () {
            $('#datetimepicker').datepicker({
                format: 'yyyy-mm-dd',
                autoclose: true
            });
        });
    </script>

    <script>
        $(document).ready(function () {
            // Initialize the dropdowns
            updateCustomerDropdown();
            updateCarrierDropdown();
            updateWorkcodeDropdown();

            // Set the initial selected values from hidden fields
            var initialSelectedCustomer = $("#selectedCustomer").val();
            var initialSelectedCarrier = $("#selectedCarrier").val();
            var initialSelectedWorkCode = $("#selectedWorkCode").val();

            $("#customerFilter").val(initialSelectedCustomer);
            $("#carrierFilter").val(initialSelectedCarrier);
            $("#workcodeFilter").val(initialSelectedWorkCode);

            // Event handlers
            $("#customerGroupFilter").change(function () {
                updateCustomerDropdown();
            });

            $("#customerFilter").change(function () {
                updateCarrierDropdown();
                updateWorkcodeDropdown();
            });

            $("#carrierFilter").change(function () {
                updateWorkcodeDropdown();
            });

            // Function to update Customer dropdown
            function updateCustomerDropdown() {
                var selectedCustomerGroup = $("#customerGroupFilter").val();
                var customerDropdown = $("#customerFilter");

                // Clear previous selections
                customerDropdown.empty().append('<option value="">Select Customer</option>');

                if (!selectedCustomerGroup) {
                    // If no customer group is selected, fetch all customers directly
                    fetchAllCustomers();
                } else {
                    // Fetch customers based on selected customer group
                    $.get(customerDropdown.data("url"), { customergroup: selectedCustomerGroup }, function (data) {
                        $.each(data, function (index, item) {
                            customerDropdown.append('<option value="' + item.value + '">' + item.text + '</option>');
                        });
                        $("#customerFilter").val(initialSelectedCustomer).trigger('change');
                    });
                }
            }

            // Function to update Carrier dropdown
            function updateCarrierDropdown() {
                var selectedCustomer = $("#customerFilter").val();
                var carrierDropdown = $("#carrierFilter");

                // Clear previous selections
                carrierDropdown.empty().append('<option value="">Select Carrier</option>');

                if (!selectedCustomer) {
                    // If no customer is selected, fetch all carriers directly
                    fetchAllCarriers();
                } else {
                    // Fetch carriers based on selected customer
                    $.get(carrierDropdown.data("url"), { customer: selectedCustomer }, function (data) {
                        $.each(data, function (index, item) {
                            carrierDropdown.append('<option value="' + item.value + '">' + item.text + '</option>');
                        });
                        $("#carrierFilter").val(initialSelectedCarrier).trigger('change');
                    });
                }
            }

            // Function to update Workcode dropdown
            function updateWorkcodeDropdown() {
                var selectedCustomer = $("#customerFilter").val();
                var selectedCarrier = $("#carrierFilter").val();
                var workcodeDropdown = $("#workcodeFilter");

                // Clear previous selections
                workcodeDropdown.empty().append('<option value="">Select Workcode</option>');

                if (selectedCustomer && selectedCarrier) {
                    // Fetch workcodes based on both customer and carrier selected
                    $.get(workcodeDropdown.data("url"), { customer: selectedCustomer, carrier: selectedCarrier }, function (data) {
                        $.each(data, function (index, item) {
                            workcodeDropdown.append('<option value="' + item.value + '">' + item.text + '</option>');
                        });
                        $("#workcodeFilter").val(initialSelectedWorkCode);
                    });
                } else if (selectedCustomer) {
                    // Fetch workcodes based on only customer selected
                    $.get(workcodeDropdown.data("url"), { customer: selectedCustomer }, function (data) {
                        $.each(data, function (index, item) {
                            workcodeDropdown.append('<option value="' + item.value + '">' + item.text + '</option>');
                        });
                        $("#workcodeFilter").val(initialSelectedWorkCode);
                    });
                } else if (selectedCarrier) {
                    // Fetch workcodes based on only carrier selected
                    $.get(workcodeDropdown.data("url"), { carrier: selectedCarrier }, function (data) {
                        $.each(data, function (index, item) {
                            workcodeDropdown.append('<option value="' + item.value + '">' + item.text + '</option>');
                        });
                        $("#workcodeFilter").val(initialSelectedWorkCode);
                    });
                } else {
                    // Fetch all unique workcodes
                    fetchAllWorkcodes();
                }
            }

            // Function to fetch all carriers
            function fetchAllCarriers() {
                var carrierDropdown = $("#carrierFilter");

                // Fetch all carriers
                $.get(carrierDropdown.data("url"), function (data) {
                    $.each(data, function (index, item) {
                        carrierDropdown.append('<option value="' + item.value + '">' + item.text + '</option>');
                    });

                    // Trigger the change event to update workcodes based on the selected carrier
                    carrierDropdown.trigger('change');
                });
            }

            // Function to fetch all customers
            function fetchAllCustomers() {
                var customerDropdown = $("#customerFilter");

                // Fetch all customers
                $.get(customerDropdown.data("url"), function (data) {
                    $.each(data, function (index, item) {
                        customerDropdown.append('<option value="' + item.value + '">' + item.text + '</option>');
                    });

                    // Trigger the change event to update workcodes based on the selected customer
                    customerDropdown.trigger('change');
                });
            }

            // Function to fetch all workcodes
            function fetchAllWorkcodes() {
                var workcodeDropdown = $("#workcodeFilter");

                // Fetch all workcodes
                $.get(workcodeDropdown.data("url"), function (data) {
                    $.each(data, function (index, item) {
                        workcodeDropdown.append('<option value="' + item.value + '">' + item.text + '</option>');
                    });
                });
            }
        });

    </script>

}
