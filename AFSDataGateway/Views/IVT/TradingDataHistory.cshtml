
@{
    ViewBag.Title = "Trading History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



@model IEnumerable<AFSDataGateway.Models.vIVT_TradingDataHistory>

@{


    ViewBag.Title = "Trading Data History";
    if (TempData["Utype"] == null)
    {
        TempData["Utype"] = 0;
    }
    if (Session["Utype"] == null)
    {
        Session["Utype"] = 0;
    }
    if ((int)TempData["Utype"] == 1 || (int)Session["Utype"] == 1)
    {

        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}



@section css {
    <style>
        .filter-table .quick {
            margin-left: 0.5em;
            font-size: 0.8em;
            text-decoration: none;
            font-family: "TitilliumWeb";
        }

        .fitler-table .quick:hover {
            text-decoration: underline;
            font-family: "TitilliumWeb";
        }

        td.alt {
            background-color: #ffc;
            background-color: rgba(255, 255, 0, 0.2);
            font-family: "TitilliumWeb";
        }

        .table {
            font-size: 14px;
        }

        #TradingDataHistory_wrapper {
            overflow-x: auto;
            max-width: 100%; /* Adjust as needed */
        }
    </style>
}

<div style="border: solid 1px blue;font-size:14px; visibility: @ViewBag.ViewMessage;font-family: TitilliumWeb">
    @if (TempData["message"] != null && @ViewBag.messageStatus == 1)
    {
        @Html.Label("", (string)TempData["message"], new { @class = "mysucesslabel" })
    }
</div>

<div style="border: solid 1px blue; font-size:14px; visibility: @ViewBag.ViewMessage;font-family: TitilliumWeb">
    @if (TempData["message"] != null && @ViewBag.messageStatus == 2)
    {
        @Html.Label("", (string)TempData["message"], new { @class = "myfaillabel" })
    }
</div>

@{
    var despatchDate = DateTime.Now;

    var Search = "";
    var customerFilter = "";
    var carrierFilter = "";
    var workcodeFilter = "";
    var SupplierRef = "";
    var SellNett = "";
}


<div class="form-horizontal">
    <div style="font-family: TitilliumWeb;color:blue">
        <h4>Explore your Historical IVT Trading Data: Use the <strong>Search</strong> function to delve into specific details.</h4>
        <h5>Displayed here are the first 100 records. For the entire dataset, utilize the download CSV button.</h5>
    </div>
</div>
<br />
@using (Html.BeginForm("TradingDataHistory", "IVT", FormMethod.Get))
{

    <div style="font-family: TitilliumWeb">
        <div class="form-group">
            @Html.Label("Invoice Week", new { @class = "control-label" })
            <div class='input-group date' id='datetimepicker'>
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
                @Html.TextBox("invoiceWeek", "yyyy-mm-dd", new { @class = "form-control", placeholder = "yyyy-mm-dd" })
            </div>

            <br />
            Customer Group @Html.DropDownList("customerGroupFilter", ViewBag.UniqueCustomerGroup as SelectList, "Select CustomerGroup")

            @*Customer @Html.DropDownList("customerFilter", ViewBag.UniqueCustomers as SelectList, "Select Customer")*@

            Customer <select id="customerFilter" name="customerFilter" data-url="@Url.Action("GetCustomers", "IVT", new { viewname = "TradingDataHistory"})">
                <option value="">@ViewBag.selectedCustomer</option>
            </select>

            Carrier <select id="carrierFilter" name="carrierFilter" data-url="@Url.Action("GetCarriers", "IVT", new { viewname = "TradingDataHistory"})">
                <option value="">@ViewBag.selectedCarrier</option>
            </select>

            Workcode <select id="workcodeFilter" name="workcodeFilter" data-url="@Url.Action("GetWorkcodes", "IVT", new { viewname = "TradingDataHistory"})">
                <option value="">@ViewBag.selectedWorkCode</option>
            </select>
            Supplier Ref @Html.TextBox("SupplierRef", SupplierRef)
            Sell Nett ( > ) @Html.TextBox("SellNett", SellNett)

            <input type="submit" value="Search" />

        </div>

    </div>
    @Html.Hidden("selectedCustomer", (string)ViewBag.selectedCustomer, new { id = "selectedCustomer" })
    @Html.Hidden("selectedCarrier", (string)ViewBag.selectedCarrier, new { id = "selectedCarrier" })
    @Html.Hidden("selectedWorkCode", (string)ViewBag.selectedWorkCode, new { id = "selectedWorkCode" })
}
<br />
@using (Html.BeginForm("TradingDataHistory", "IVT", FormMethod.Post))
