@using (Html.BeginForm("HeldConsignment", "IVT", FormMethod.Get))
{

    <div class="form-row">
        <div>
            <label class="form-label">Search(Any)</label>
            @Html.TextBox("search", ViewBag.Search as string, new { @class = "form-control" })
        </div>

        <div>
            <label class="form-label">Customer Group</label>
            @Html.DropDownList("customerGroupFilter", ViewBag.UniqueCustomerGroup as SelectList, "Select CustomerGroup", new { @class = "form-control" })
        </div>

        <div>
            <label class="form-label">Customer</label>
            <select id="customerFilter" name="customerFilter" class="form-control" data-url="@Url.Action("GetCustomers", "IVT", new { viewname = "HeldConsignment" })">
                <option value="">@ViewBag.selectedcustomer</option>
            </select>
        </div>

        <div>
            <label class="form-label">Carrier</label>
            <select id="carrierFilter" name="carrierFilter" class="form-control" data-url="@Url.Action("GetCarriers", "IVT", new { viewname = "HeldConsignment" })">
                <option value="">@ViewBag.selectedCarrier</option>
            </select>
        </div>



        <div>
            <input type="submit" value="Search" />
        </div>
    </div>

    @Html.Hidden("selectedCustomer", (string)ViewBag.selectedCustomer, new { id = "selectedCustomer" })
    @Html.Hidden("selectedCarrier", (string)ViewBag.selectedCarrier, new { id = "selectedCarrier" })


    <br />
    <div style="font-family: TitilliumWeb;color:maroon">
        <h4>You can <strong>Release</strong> multiple connotes shared the same <strong>Justification.</strong> </h4>
    </div>
    <br />

    <div>
        <a href="@Url.Action("DownloadCSV_HeldConsignment", "IVT")" class="btn btn-primary">Download CSV</a>
        <button class="btn btn-secondary" onclick="refreshPage()">Refresh</button>
    </div>
    <br />
}
@using (Html.BeginForm("HeldConsignment", "IVT", FormMethod.Post, new { @class = "form-to-release" }))
{

    <div class="form-horizontal">
        @Html.Label("Justification", new { title = "Reason" })
        @Html.TextArea("Reason", htmlAttributes: new { placeholder = "Why are you releasing the consignment(s)?", style = "width: 100%; max-width: 100%;", title = "Reasons" })

        <input type="submit" value="Release" class="btn btn-primary" />
    </div>
    <br />
    @*<div style="color:blue;font-family: TitilliumWeb-Regular">
            For The Period Between @startdate.ToShortDateString() and @enddate.ToShortDateString().
        </div>*@
    <hr style="height:2px; width:100%; border-width:0; color:blue; background-color:black" />
    @*<input type="button" name="CheckAll" id="CheckAll" onclick="Selectall();" value="Select All" class="btn btn-primary" />*@


    <div>
        <input type="checkbox" id="CheckAll" /><span style="font-size:16px">Select All</span>
    </div>

    <div class="table-responsive" id="checkboxes">
        <table id="HeldConsignment" class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th></th>
                    <th style="white-space: nowrap;">@Html.Label("", "InvoiceWeek")</th>
                    <th>@Html.Label("", "Connote")</th>
                    <th>@Html.Label("", "Customer")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "Held Reason")</th>
                    <th>@Html.Label("", "ErrCode")</th>
                    <th>@Html.Label("", "Exception")</th>
                    <th>@Html.Label("", "Carrier")</th>
                    <th style="white-space: nowrap;">@Html.Label("", "ConnoteDate")</th>
                    <th>@Html.Label("", "Exception Detail")</th>
                    <th>@Html.Label("", "Action")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><input type="checkbox" name="ID" value="@item.Id" class="custom-checkbox chkCheckBoxId" /></td>
                        <td>@Convert.ToDateTime(item.CurrentWeek).ToString("dd/MM/yyyy")</td>
                        <td style="white-space: nowrap;">@Html.DisplayFor(modelItem => item.Connote)</td>
                        <td style="white-space: nowrap;">@Html.DisplayFor(modelItem => item.Customer)</td>
                        <td style="white-space: nowrap;">@Html.DisplayFor(modelItem => item.Comment)</td>
                        <td style="white-space: nowrap;">@Html.DisplayFor(modelItem => item.ErrCode)</td>
                        <td style="white-space: nowrap;">@Html.DisplayFor(modelItem => item.Reason)</td>
                        <td style="white-space: nowrap;">@Html.DisplayFor(modelItem => item.Carrier)</td>
                        <td>
                            @{
                                DateTime consignmentDate;
                                string formattedConsignmentDate = DateTime.TryParse(item.cons_date?.ToString(), out consignmentDate)
                                    ? consignmentDate.ToString("dd/MM/yyyy")
                                    : "N/A"; // Show "N/A" if the date is invalid
                            }
                            @formattedConsignmentDate
                        </td>
                        <td style="white-space: nowrap;">@Html.DisplayFor(modelItem => item.Sub_Reason)</td>
                        <td style="white-space: nowrap;">
                            @Html.ActionLink("View", "ViewHeldConsignment", new { Id = item.Id }) |
                            @Html.ActionLink("Release", "ReleaseConsignment", new { Id = item.Id, Connote = item.Connote, despatchDate = item.cons_date })
                            @*@Html.ActionLink("Update", "Edit", new { Id = item.cId, Connote = item.ConsignmentNo, despatchDate = item.DespatchDate })*@
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
}

