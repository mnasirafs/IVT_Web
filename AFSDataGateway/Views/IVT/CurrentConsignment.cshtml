@using (Html.BeginForm("CurrentConsignment", "IVT", FormMethod.Post))
{
<div class="form-horizontal">
    @Html.Label("Hold Reason", new { title = "Reason" })
    @Html.TextArea("Reason", htmlAttributes: new { placeholder = "Why are you holding the consignment(s)?", style = "width: 100%; max-width: 100%;", title = "Reasons" })


        @Html.Hidden("selectedCustomerGroupValue", (string)ViewBag.selectedCustomerGroup, new { id = "selectedCustomerGroupValue" })
        @Html.Hidden("selectedCustomerValue", ViewBag.selectedCustomer != null ? string.Join(",", ViewBag.selectedCustomer as string[]) : "", new { id = "selectedCustomerValue" })
        @Html.Hidden("selectedCarrierValue", ViewBag.selectedCarrier != null ? string.Join(",", ViewBag.selectedCarrier as string[]) : "", new { id = "selectedCarrierValue" })
        @Html.Hidden("selectedWorkCodeValue", ViewBag.selectedWorkCode != null ? string.Join(",", ViewBag.selectedWorkCode as string[]) : "", new { id = "selectedWorkCodeValue" })

        <input type="submit" value="Hold" class="btn btn-primary" />
    </div>



    <br />
    @*<div style="color:blue;font-family: TitilliumWeb-Regular">
            For The Period Between @startdate.ToShortDateString() and @enddate.ToShortDateString().
        </div>*@
    <hr style="height:2px; width:100%; border-width:0; color:blue; background-color:black" />


    @*<div>
            <a href="@Url.Action("DownloadCSV_IVTResults", "IVT")" class="btn btn-primary">Download CSV</a>
        </div>
        <br />*@
    <div>
        <input type="checkbox" id="CheckAll" /><span style="font-size:16px">Select All</span>
    </div>
    <div id="checkboxes">
        <table class="table table-bordered table-striped " id="IVTResutlsTable">
            <thead>
                <tr>

                    <th></th>

                    <th>Connote</th>
                    <th>ConnoteDate</th>
                    <th>CustomerGroup</th>
                    <th>Customer</th>
                    <th>Carrier</th>
                    <th id="SellNettHeader">SellNett</th>
                    <th>BuyNett</th>
                    <th>GM$$</th>
                    <th>GM%</th>
                    <th>SellFreight</th>
                    <th>SellOther</th>
                    <th>SellFuel</th>
                    <th>BuyFreight</th>
                    <th>BuyOther</th>
                    <th>BuyFuel</th>
                    <th>QTY</th>
                    <th>Weight</th>
                    <th>Cubic</th>
                    <th>WorkCode</th>
                    <th>Reason</th>
                    <th>Exception Detail</th>
                    <th>CusRef</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        @{
                            decimal totalNett = Convert.ToDecimal(item.total_nett);
                            decimal buyNett = Convert.ToDecimal(item.BuyNett);
                            decimal BuyFuel = Convert.ToDecimal(item.Buy_fuel_surch);
                            decimal SellFuel = Convert.ToDecimal(item.fuel_surch);
                            decimal BuyFreight = Convert.ToDecimal(item.Buy_freight_charges);
                            decimal SellFreight = Convert.ToDecimal(item.freight_charges);
                            decimal BuyOther = Convert.ToDecimal(item.Buy_other_charges);
                            decimal SellOther = Convert.ToDecimal(item.other_charges);
                        }


                        <td><input type="checkbox" name="ID" value="@item.Id" class="custom-checkbox chkCheckBoxId" /></td>

                        <td style="white-space:nowrap">@Html.DisplayFor(modelItem => item.Connote)</td>
                        <td>@Convert.ToDateTime(item.cons_date).ToString("dd/MM/yyyy")</td>
                        <td style="white-space:nowrap">@Html.DisplayFor(modelItem => item.FinanceGroup)</td>
                        <td style="white-space:nowrap">@Html.DisplayFor(modelItem => item.customer)</td>
                        <td style="white-space:nowrap">@Html.DisplayFor(modelItem => item.carrier)</td>
                        <td style="white-space:nowrap">@String.Format("{0:C}", totalNett)</td>
                        <td style="white-space:nowrap">@String.Format("{0:C}", buyNett)</td>
                        <td style="white-space:nowrap">@String.Format("{0:C}", totalNett - buyNett)</td>
                        <td style="white-space:nowrap">@String.Format("{0:0.00}%", item.GrossMargin)</td>
                        <td style="white-space:nowrap">@String.Format("{0:C}", SellFreight)</td>
                        <td style="white-space:nowrap">@String.Format("{0:C}", SellOther)</td>
                        <td style="white-space:nowrap">@String.Format("{0:C}", SellFuel)</td>
                        <td style="white-space:nowrap">@String.Format("{0:C}", BuyFreight)</td>
                        <td style="white-space:nowrap">@String.Format("{0:C}", BuyOther)</td>
                        <td style="white-space:nowrap">@String.Format("{0:C}", BuyFuel)</td>
                        <td style="white-space:nowrap">@Html.DisplayFor(modelItem => item.quantity)</td>
                        <td style="white-space:nowrap">@Html.DisplayFor(modelItem => item.chg_kg)</td>
                        <td style="white-space:nowrap">@Html.DisplayFor(modelItem => item.cubic)</td>
                        <td style="white-space:nowrap">@Html.DisplayFor(modelItem => item.work_code)</td>
                        <td style="white-space:nowrap">@Html.DisplayFor(modelItem => item.Reason)</td>
                        <td style="white-space:nowrap">@Html.DisplayFor(modelItem => item.Sub_Reason)</td>
                        <td style="white-space:nowrap">@Html.DisplayFor(modelItem => item.cus_ref)</td>

                        <td style="white-space:nowrap">
                            @Html.ActionLink("View", "ViewReleasedConsignment", new { Id = item.Id }) |
                            @Html.ActionLink("Hold", "HoldConsignment", new { Id = item.Id })
                            @* Uncomment the following line if needed
                                @Html.ActionLink("Update", "Edit", new { Id = item.cId, Connote = item.ConsignmentNo, despatchDate = item.DespatchDate })
                            *@
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    @*<td style="white-space:nowrap">@Model.Count(m => !string.IsNullOrEmpty(m.con_note)) Connotes</td>*@
                    <td colspan="6">Total of @Model.Count(m => !string.IsNullOrEmpty(m.con_note)) Connotes</td>
                    <td style="white-space:nowrap">@Model.Sum(m => Convert.ToDecimal(m.total_nett)).ToString("C")</td>
                    <td style="white-space:nowrap">@Model.Sum(m => Convert.ToDecimal(m.BuyNett)).ToString("C")</td>
                    <td style="white-space:nowrap">@((Model.Sum(m => Convert.ToDecimal(m.total_nett)) - Model.Sum(m => Convert.ToDecimal(m.BuyNett))).ToString("C"))</td>
                    <td colspan="1"></td>
                    <td style="white-space:nowrap">@Model.Sum(m => Convert.ToDecimal(m.freight_charges)).ToString("C")</td>
                    <td style="white-space:nowrap">@Model.Sum(m => Convert.ToDecimal(m.other_charges)).ToString("C")</td>
                    <td style="white-space:nowrap">@Model.Sum(m => Convert.ToDecimal(m.fuel_surch)).ToString("C")</td>

                    <td style="white-space:nowrap">@Model.Sum(m => Convert.ToDecimal(m.Buy_freight_charges)).ToString("C")</td>
                    <td style="white-space:nowrap">@Model.Sum(m => Convert.ToDecimal(m.Buy_other_charges)).ToString("C")</td>
                    <td style="white-space:nowrap">@Model.Sum(m => Convert.ToDecimal(m.Buy_fuel_surch)).ToString("C")</td>


                    <td style="white-space:nowrap">@Model.Sum(m => Convert.ToDecimal(m.quantity)).ToString("0.00")</td>
                    <td style="white-space:nowrap">@Model.Sum(m => Convert.ToDecimal(m.chg_kg)).ToString("0.00")</td>
                    <td style="white-space:nowrap">@Model.Sum(m => Convert.ToDecimal(m.cubic)).ToString("0.00")</td>


                    <td colspan="4"></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <br />

}


