@using (Html.BeginForm("AncillarySummary", "IVT", FormMethod.Get))
{

    <div class="form-row">
        <div>
            <label class="form-label">Search(Any)</label>
            @Html.TextBox("search", ViewBag.Search as string, new { @class = "form-control" })
        </div>

        <div>
            <label class="form-label">Customer Group</label>
            @Html.DropDownList("customerGroupFilter", ViewBag.UniqueCustomerGroup as SelectList, "Select CustomerGroup", new { @class = "form-control" })
        </div>

        <div>
            <label class="form-label">Customer</label>
            <select id="customerFilter" name="customerFilter" class="form-control" data-url="@Url.Action("GetCustomers", "IVT", new { viewname = "AncillarySummary"})">
                <option value="">@ViewBag.selectedcustomer</option>
            </select>
        </div>

        <div>
            <label class="form-label">Carrier</label>
            <select id="carrierFilter" name="carrierFilter" class="form-control" data-url="@Url.Action("GetCarriers", "IVT", new { viewname = "AncillarySummary"})">
                <option value="">@ViewBag.selectedCarrier</option>
            </select>
        </div>

        <div>
            <label class="form-label">Workcode</label>
            <select id="workcodeFilter" name="workcodeFilter" class="form-control" data-url="@Url.Action("GetWorkcodes", "IVT", new { viewname = "AncillarySummary"})">
                <option value="">@ViewBag.selectedWorkCode</option>
            </select>
        </div>

        <div>
            <input type="submit" value="Search" />
        </div>
    </div>



    @Html.Hidden("selectedCustomer", (string)ViewBag.selectedCustomer, new { id = "selectedCustomer" })
    @Html.Hidden("selectedCarrier", (string)ViewBag.selectedCarrier, new { id = "selectedCarrier" })
    @Html.Hidden("selectedWorkCode", (string)ViewBag.selectedWorkCode, new { id = "selectedWorkCode" })
