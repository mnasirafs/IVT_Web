            <DefiningQuery>SELECT 
    [FileInfoes].[Id] AS [Id], 
    [FileInfoes].[FileName] AS [FileName], 
    [FileInfoes].[Status] AS [Status], 
    [FileInfoes].[StartTime] AS [StartTime], 
    [FileInfoes].[FinishTime] AS [FinishTime]
    FROM [dbo].[FileInfoes] AS [FileInfoes]</DefiningQuery>
          </EntitySet>
          <EntitySet Name="AncillarySummary" EntityType="Self.AncillarySummary" store:Type="Tables" store:Schema="tmp">
            <DefiningQuery>SELECT 
    [AncillarySummary].[Id] AS [Id], 
    [AncillarySummary].[CustomerCode] AS [CustomerCode], 
    [AncillarySummary].[Carrier] AS [Carrier], 
    [AncillarySummary].[WorkCode] AS [WorkCode], 
    [AncillarySummary].[CurrentWeekAvgTotalAncillaries] AS [CurrentWeekAvgTotalAncillaries], 
    [AncillarySummary].[CurrentWeekAvgSellTotalNett] AS [CurrentWeekAvgSellTotalNett], 
    [AncillarySummary].[CurrentWeekAvgBuyTotalNett] AS [CurrentWeekAvgBuyTotalNett], 
    [AncillarySummary].[CurrentGrossMargin] AS [CurrentGrossMargin], 
    [AncillarySummary].[AncillaryDesc] AS [AncillaryDesc], 
    [AncillarySummary].[13WeekAvgTotalAncillaries] AS [13WeekAvgTotalAncillaries], 
    [AncillarySummary].[13WeekAvgBuyTotalNett] AS [13WeekAvgBuyTotalNett], 
    [AncillarySummary].[13WeekAvgSellTotalNett] AS [13WeekAvgSellTotalNett], 
    [AncillarySummary].[AvgGrossMargin] AS [AvgGrossMargin], 
    [AncillarySummary].[AccountManager] AS [AccountManager], 
    [AncillarySummary].[LoginName] AS [LoginName], 
    [AncillarySummary].[ContactEmail] AS [ContactEmail]
    FROM [tmp].[AncillarySummary] AS [AncillarySummary]</DefiningQuery>
          </EntitySet>
          <EntitySet Name="CustomerRef_Last12M" EntityType="Self.CustomerRef_Last12M" store:Type="Tables" store:Schema="tmp">
            <DefiningQuery>SELECT 
    [CustomerRef_Last12M].[Jno] AS [Jno], 
    [CustomerRef_Last12M].[CustomerReference] AS [CustomerReference], 
    [CustomerRef_Last12M].[ConsignmentDate] AS [ConsignmentDate], 
    [CustomerRef_Last12M].[ConsignmentNote] AS [ConsignmentNote], 
    [CustomerRef_Last12M].[customer] AS [customer], 
    [CustomerRef_Last12M].[Carrier] AS [Carrier], 
    [CustomerRef_Last12M].[InvoiceDate] AS [InvoiceDate], 
    [CustomerRef_Last12M].[ActionTime] AS [ActionTime]
    FROM [tmp].[CustomerRef_Last12M] AS [CustomerRef_Last12M]</DefiningQuery>
          </EntitySet>
          <EntitySet Name="Last13WKAncillary" EntityType="Self.Last13WKAncillary" store:Type="Tables" store:Schema="tmp">
