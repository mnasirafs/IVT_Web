<div id="pieChartContainer" style="height: 400px;"></div>
<br />
<div id="checkboxes">
    <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
        <thead style="background-color: #f2f2f2;">
            <tr>
                <th style=" font-size:16px;border: 1px solid #ddd; padding: 8px;">Rule Code</th>
                <th style=" font-size:16px;border: 1px solid #ddd; padding: 8px;">Sub Code</th>
                <th style=" font-size:16px;border: 1px solid #ddd; padding: 8px;">Error Description</th>
                <th style="font-size: 16px;border: 1px solid #ddd; padding: 8px;">Current Week Count</th>
                <th style="font-size: 16px;border: 1px solid #ddd; padding: 8px;">Last Week Count</th>
                <th style="font-size: 16px;border: 1px solid #ddd; padding: 8px;">Last 13 Weeks Avg Count</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Exception_summary_list)
            {
            <tr>
                <td style="font-size:16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">@item.RuleCategory</td>
                <td style="font-size:16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">@item.RuleCode</td>
                <td style="font-size:16px; border: 1px solid #ddd; padding: 8px; white-space: nowrap;">@item.ErrDesc</td>
                <td style="font-size: 16px;border: 1px solid #ddd; padding: 8px; white-space: nowrap;">@item.CurrentWeekCount</td>
                <td style="font-size: 16px;border: 1px solid #ddd; padding: 8px; white-space: nowrap;">@item.LastWeekCount</td>
                <td style="font-size: 16px;border: 1px solid #ddd; padding: 8px; white-space: nowrap;">@item.Last13WeeksAvgCount</td>
            </tr>
            }
        </tbody>
    </table>
</div>
