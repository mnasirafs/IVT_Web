<!-- Placeholder for the doughnut chart -->
<div id="lineChartLastIVTRUN" style="height: 400px;"></div>

@section scripts {
    <script src="https://code.highcharts.com/highcharts.js"></script>
    <script src="https://code.highcharts.com/modules/data.js"></script>
    <script src="https://code.highcharts.com/modules/exporting.js"></script>
    <script src="https://code.highcharts.com/modules/export-data.js"></script>



    <!-- Cards for Total Measures Data -->


    <script>



        // Line Chart for Top 10 Carrier Data
       // Line Chart for Top Carriers
Highcharts.chart('lineChartContainer', {
    chart: {
        type: 'line'
    },
    title: {
        text: 'Top Carriers',
        style: {
            fontSize: '18px' // Set the desired font size for the title
        }
    },
    xAxis: {
        categories: [
            @foreach (var item in Model.Top10CarrierData) {
                <text>'@item.carrier',</text>
            }
        ],
        title: {
            text: 'Carriers',
            style: {
                fontSize: '14px' // Set the desired font size for xAxis title
            }
        },
        labels: {
            style: {
                fontSize: '14px' // Set the desired font size for xAxis labels
            }
        }
    },
    yAxis: {
        title: {
            text: 'TotCount',
            style: {
                fontSize: '14px' // Set the desired font size for yAxis title
            }
        },
        labels: {
            style: {
                fontSize: '14px' // Set the desired font size for yAxis labels
            }
        }
    },
    series: [{
        name: 'TotCount',
        data: [
            @foreach (var item in Model.Top10CarrierData) {
                <text>@item.TotCount,</text>
            }
        ],
        color: 'rgba(255, 99, 132, 0.7)',
        marker: {
            symbol: 'circle'
        }
    }],
    responsive: {
        rules: [{
            condition: {
                maxWidth: 500
            },
            chartOptions: {
                legend: {
                    layout: 'horizontal',
                    align: 'center',
                    verticalAlign: 'bottom'
                }
            }
        }]
    }
});






         var top10ExceptionData = @Html.Raw(Json.Encode(Model.Top10ExceptionData.Count > 0 ? Model.Top10ExceptionData : null));

        if (top10ExceptionData) {
            // Pie Chart for Top 10 Exception Data
            // Pie Chart for Top Exceptions
            Highcharts.chart('pieChartContainer', {
                chart: {
                    type: 'pie'
                },
                title: {
                    text: 'Top Exceptions',
                    style: {
                        fontSize: '18px' // Set the desired font size for the title
                    }
                },
                plotOptions: {
                    pie: {
                        allowPointSelect: true,
                        cursor: 'pointer',
                        dataLabels: {
                            enabled: true,
                            format: '<b>{point.name}</b>: {point.y}',
                            style: {
                                fontSize: '12px' // Set the desired font size for data labels
                            }
                        }
                    }
                },
                series: [{
                    name: 'Exceptions',
                    colorByPoint: true,
                    data: top10ExceptionData.map(function (item) {
                        return { name: item.ErrDesc, y: item.TotCount };
                    })
                }],
                responsive: {
                    rules: [{
                        condition: {
                            maxWidth: 500
                        },
                        chartOptions: {
                            legend: {
                                layout: 'horizontal',
                                align: 'center',
                                verticalAlign: 'bottom'
                            }
                        }
                    }]
                }
            });
        }

        var top10CustomerData = @Html.Raw(Json.Encode(Model.Top10CustomerData.Count > 0 ? Model.Top10CustomerData : null));

        if (top10CustomerData) {
            // Bar Chart for Top 10 Customer Data
            // Bar Chart for Top Customers
            Highcharts.chart('barChartContainer', {
                chart: {
                    type: 'bar'
                },
                title: {
                    text: 'Top Customers',
                    style: {
                        fontSize: '18px' // Set the desired font size for the title
                    }
                },
                xAxis: {
                    categories: top10CustomerData.map(function (item) {
                        return item.FinanceGroup;
                    }),
                    title: {
                        text: 'Customers',
                        style: {
                            fontSize: '14px' // Set the desired font size for xAxis title
                        }
                    },
                    labels: {
                        style: {
                            fontSize: '12px' // Set the desired font size for xAxis labels
                        }
                    }
                },
                yAxis: {
                    title: {
                        text: 'Total Exceptions',
                        style: {
                            fontSize: '14px' // Set the desired font size for yAxis title
                        }
                    },
                    labels: {
                        style: {
                            fontSize: '12px' // Set the desired font size for yAxis labels
                        }
                    }
                },
                series: [{
                    name: 'Total Exceptions',
                    data: top10CustomerData.map(function (item) {
                        return item.TotCount;
                    }),
                    color: 'rgba(75, 192, 192, 0.7)'
                }],
                plotOptions: {
                    column: {
                        pointPadding: 0.2,
                        borderWidth: 0
                    }
                },
                responsive: {
                    rules: [{
                        condition: {
                            maxWidth: 500
                        },
                        chartOptions: {
                            legend: {
                                layout: 'horizontal',
                                align: 'center',
                                verticalAlign: 'bottom'
                            }
                        }
                    }]
                }
            });

        }

         // Line Chart for Last_IVTRUN Data

Highcharts.chart('lineChartLastIVTRUN', {
    chart: {
        type: 'line'
    },
    title: {
        text: 'IVT Trend',
        style: {
            fontSize: '18px' // Set the desired font size for the title
        }
    },
    xAxis: {
        categories: [
            @foreach (var item in Model.LastIVTRunData) {
                <text>'@(item.CurrentWeek.ToString("dd/MM/yyyy"))',</text>
            }
        ],
        title: {
            text: 'Invoice Weeks',
            style: {
                fontSize: '14px' // Set the desired font size for xAxis title
            }
        },
        labels: {
            style: {
                fontSize: '14px' // Set the desired font size for xAxis labels
            }
        }
    },
    yAxis: {
        title: {
            text: 'Exceptions',
            style: {
                fontSize: '14px' // Set the desired font size for yAxis title
            }
        },
        labels: {
            style: {
                fontSize: '14px' // Set the desired font size for yAxis labels
            }
        }
    },
    series: [{
        name: 'Counts',
        data: [
            @foreach (var item in Model.LastIVTRunData) {
                <text>@item.TotCount,</text>
            }
        ],
        color: 'rgba(255, 99, 132, 0.7)',
        marker: {
            symbol: 'circle'
        }
    }],
    responsive: {
        rules: [{
            condition: {
                maxWidth: 500
            },
            chartOptions: {
                legend: {
                    layout: 'horizontal',
                    align: 'center',
                    verticalAlign: 'bottom'
                }
            }
        }]
    }
});

    </script>



}
