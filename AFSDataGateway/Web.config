<?xml version="1.0"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=301880
  -->
<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
  </configSections>
  <!-- Server-only secrets (e.g. AZURE_OPENAI_*) live in App_Data\ivt-chat.secrets.config, which is not in source control or the
       publish output; its keys override the placeholders below. The file is optional: if it is missing, it is ignored. -->
  <appSettings file="App_Data\ivt-chat.secrets.config">
    <add key="webpages:Version" value="3.0.0.0"/>
    <add key="webpages:Enabled" value="false"/>
    <add key="ClientValidationEnabled" value="true"/>
    <add key="UnobtrusiveJavaScriptEnabled" value="true"/>
    <!-- This branch uses Windows auth, not OWIN; ignore stray Microsoft.Owin.Host.SystemWeb.dll left in bin by other deployments. -->
    <add key="owin:AutomaticAppStartup" value="false"/>
    <!-- Keep migrated staff linked to their existing IVT LoginName. Separate entries with semicolons. -->
    <add key="IVT_USER_EMAILS" value=""/>
    <add key="IVT_USER_ALIASES" value=""/>
    <!-- Email domains accepted as staff identities (altfs.com.au = AFS tenant primary domain, afslogistics.com.au = alias). -->
    <add key="IVT_COMPANY_DOMAINS" value="afslogistics.com.au;altfs.com.au;efmlogistics.com.au"/>
    <!-- Add the actual EFM AD LDAP root here if it is a separate trusted directory. -->
    <add key="IVT_AUTH_LDAP_PATHS" value="LDAP://DC=afs,DC=local"/>
    <!-- Microsoft Entra ID sign-in + Graph mail. Put IVT_ENTRA_CLIENT_SECRET in App_Data\ivt-chat.secrets.config or an
         app-pool environment variable, never here. ALLOWED_TENANTS: semicolon list; add the EFM tenant ID for multi-tenant. -->
    <add key="IVT_ENTRA_ENABLED" value="false"/>
    <add key="IVT_ENTRA_REQUIRED" value="false"/>
    <add key="IVT_ENTRA_TENANT_ID" value="00b6e27a-f85c-4d05-8668-57fd7cc1ec1c"/>
    <add key="IVT_ENTRA_CLIENT_ID" value="80249579-f4e8-485e-bea8-a14db308f590"/>
    <!-- AFS tenant; EFM tenant (efmlogistics.com.au). -->
    <add key="IVT_ENTRA_ALLOWED_TENANTS" value="00b6e27a-f85c-4d05-8668-57fd7cc1ec1c;6290e30a-fb64-47cc-9c64-30e1a00b24e6"/>
    <add key="IVT_ENTRA_REDIRECT_URI" value=""/>
    <add key="IVT_GRAPH_SENDERS" value="AFSReports@afslogistics.com.au"/>
    <!-- IVT chat (Azure OpenAI). Real values come from IIS app-pool environment variables; never commit them. -->
    <add key="AZURE_OPENAI_ENDPOINT" value="SET_IN_APP_SERVICE"/>
    <add key="AZURE_OPENAI_API_KEY" value="SET_IN_APP_SERVICE"/>
    <add key="AZURE_OPENAI_DEPLOYMENT" value="SET_IN_APP_SERVICE"/>
    <add key="IVT_CHAT_ENABLED" value="true"/>
    <!-- ML scoring from Admin Controls: paths on the IIS server (see ivt-ml/docs/operations_runbook.md). -->
    <add key="IVT_ML_PYTHON" value="SET_ON_SERVER"/>
    <add key="IVT_ML_WORKDIR" value="SET_ON_SERVER"/>
    <add key="IVT_ML_ARTIFACT_DIR" value="SET_ON_SERVER"/>
    <add key="IVT_ML_CONFIG_VERSION" value="dev-defaults"/>
  </appSettings>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.7" />
      </system.Web>
  -->
  <system.web>
    <authentication mode="Windows"/>
    <identity impersonate="true"/>
    <compilation targetFramework="4.7" debug="true"/>
    <customErrors mode="Off"/>
    <!-- Dates are stored as dd/MM/yyyy text and money is AUD: match the on-prem server's Australian locale (Azure defaults to en-US). -->
    <globalization culture="en-AU" uiCulture="en-AU"/>
    <httpRuntime targetFramework="4.7" requestPathInvalidCharacters="&lt;,&gt;,%,&amp;,\,?"/>
  </system.web>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Antlr3.Runtime" publicKeyToken="eb42632606e9261f"/>
        <bindingRedirect oldVersion="0.0.0.0-3.5.0.2" newVersion="3.5.0.2"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed"/>
        <bindingRedirect oldVersion="0.0.0.0-12.0.0.0" newVersion="12.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Optimization" publicKeyToken="31bf3856ad364e35"/>
        <bindingRedirect oldVersion="1.0.0.0-1.1.0.0" newVersion="1.1.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="WebGrease" publicKeyToken="31bf3856ad364e35"/>
        <bindingRedirect oldVersion="0.0.0.0-1.6.5135.21930" newVersion="1.6.5135.21930"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35"/>
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35"/>
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35"/>
        <bindingRedirect oldVersion="1.0.0.0-5.2.7.0" newVersion="5.2.7.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-4.0.4.1" newVersion="4.0.4.1"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701"/>
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+"/>
    </compilers>
  </system.codedom>
  <connectionStrings>
    <add name="AFSXchange1Entities" connectionString="metadata=res://*/Models.Model1.csdl|res://*/Models.Model1.ssdl|res://*/Models.Model1.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=YOUR_SQL_SERVER;initial catalog=AFSXchange1;persist security info=True;user id=YOUR_DB_USER;password=YOUR_DB_PASSWORD;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient"/>
    <add name="IVTEntities" connectionString="metadata=res://*/Models.IVT_Model.csdl|res://*/Models.IVT_Model.ssdl|res://*/Models.IVT_Model.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=YOUR_SQL_SERVER;initial catalog=IVT;user id=YOUR_DB_USER;password=YOUR_DB_PASSWORD;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient"/>
  </connectionStrings>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.LocalDbConnectionFactory, EntityFramework">
      <parameters>
        <parameter value="mssqllocaldb"/>
      </parameters>
    </defaultConnectionFactory>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer"/>
    </providers>
  </entityFramework>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false"/>
    <directoryBrowse enabled="true"/>
  </system.webServer>
</configuration>
